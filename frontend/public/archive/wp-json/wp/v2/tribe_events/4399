{"id":4399,"date":"2021-05-06T21:45:22","date_gmt":"2021-05-06T21:45:22","guid":{"rendered":"https:\/\/lovetoronto.org\/?post_type=tribe_events&#038;p=4399"},"modified":"2021-05-06T21:56:14","modified_gmt":"2021-05-06T21:56:14","slug":"%ec%98%81%ec%a3%bc%ea%b6%8c%eb%b6%80%ec%97%ac%ed%8a%b9%eb%b3%84%ed%94%84%eb%a1%9c%ea%b7%b8%eb%9e%a8","status":"publish","type":"tribe_events","link":"https:\/\/lovetoronto.org\/event-item\/%ec%98%81%ec%a3%bc%ea%b6%8c%eb%b6%80%ec%97%ac%ed%8a%b9%eb%b3%84%ed%94%84%eb%a1%9c%ea%b7%b8%eb%9e%a8\/","title":{"rendered":"\uc678\uad6d\uc778 \uc784\uc2dc \uadfc\ub85c\uc790 \ubc0f \uc720\ud559\uc0dd 9\ub9cc \uba85\uc5d0\uac8c \uc601\uc8fc\uad8c\uc744 \ubd80\uc5ec\ud558\ub294 \uc77c\ud68c\uc131 \ud2b9\ubcc4 \ud504\ub85c\uadf8\ub7a8"},"content":{"rendered":"<p><strong>\uc790\ub8cc\uc81c\uacf5: \uc70c\ub85c\uc6b0\ub370\uc77c \uc5f0\ubc29\ud558\uc6d0\uc758\uc6d0 \uc54c\ub9ac \uc5d0\uc0ac\uc2dc (Ali Ehsassi)\u00a0<\/strong><\/p>\n<p><strong>\uc678\uad6d\uc778 \uc784\uc2dc \uadfc\ub85c\uc790 \ubc0f \uc720\ud559\uc0dd 9\ub9cc \uba85\uc5d0\uac8c \uc601\uc8fc\uad8c\uc744 \ubd80\uc5ec\ud558\ub294 \uc77c\ud68c\uc131 \ud2b9\ubcc4 \ud504\ub85c\uadf8\ub7a8\uc758 \uc2e0\uccad\uc11c\uac00 \uc624\ub298 \uc5f4\ub9bd\ub2c8\ub2e4.<\/strong><\/p>\n<p>\uc9c0\uc6d0\uc790\uaca9\uc740 2021\ub144 5\uc6d4 6\uc77c \uc624\ud6c4 12\uc2dc (\ub3d9\ubd80 \ud45c\uc900\uc2dc)\ubd80\ud130 IRCC\uc758 \uc628\ub77c\uc778 \ud3ec\ud138\uc744 \ud1b5\ud574 \uc2e0\uccad\uc11c\ub97c \uc81c\ucd9c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uaca9\uc744 \uac16\ucd94\uae30 \uc704\ud574\uc11c\ub294 \uadfc\ub85c\uc790\uac00 \uc758\ub8cc \uc804\ubb38\uc9c1 \ub610\ub294 \uc0ac\uc804 \uc2b9\uc778\ub41c \ub610 \ub2e4\ub978 \ud544\uc218 \uc9c1\uc885\uc5d0\uc11c 1\ub144 \uc774\uc0c1\uc758 \uce90\ub098\ub2e4 \uadfc\ubb34 \uacbd\ub825\uc774 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uad6d\uc81c \uc878\uc5c5\uc0dd\ub4e4\uc740 \uce90\ub098\ub2e4\uc5d0\uc11c \uc9c0\ub09c 4\ub144 \uc774\ub0b4\uc5d0, \uadf8\ub9ac\uace0 2017\ub144 1\uc6d4 \uc774\uc804\uc5d0 \ud574\ub2f9\uc774 \ub418\ub294 \ud3ec\uc2a4\ud2b8\uc138\ucee8\ub354\ub9ac (post-secondary)\uc758 \ud504\ub85c\uadf8\ub7a8\uc744 \uc774\uc218\ud574\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\ud3ec\ud138\uc740 2021\ub144 11\uc6d4 5\uc77c\uae4c\uc9c0 \ub610\ub294 \ucd5c\ub300 \uc2e0\uccad \uc218\uc5d0 \ub3c4\ub2ec\ud560 \ub54c\uae4c\uc9c0 \uac1c\ubc29\ub429\ub2c8\ub2e4:<\/p>\n<p>\uc758\ub8cc\ubd84\uc57c \uc784\uc2dc\uc9c1 \uadfc\ub85c\uc790 \uc2e0\uccad 20,000\uac74<\/p>\n<p>\uae30\ud0c0 \uc120\uc815\ub41c \ud544\uc218 \uc9c1\uc885\uc5d0 \uc885\uc0ac\ud558\ub294 \uc784\uc2dc\uc9c1 \uadfc\ub85c\uc790\uc5d0 \ub300\ud55c 30,000\uac74<\/p>\n<p>\ud574\ub2f9\uc544 \ub418\ub294 \uce90\ub098\ub2e4 \uae30\uad00\uc5d0\uc11c \uc878\uc5c5\ud55c \uc720\ud559\uc0dd 40,000\uba85<\/p>\n<p>\uc774 \uc77c\ud68c\uc131 \ud2b9\ubcc4 \ud504\ub85c\uadf8\ub7a8 \uc9c0\uc6d0\uc790\ub4e4\uc740 \uc790\uaca9\uc744 \uc5bb\uae30 \uc704\ud574 \ud018\ubca1 (Quebec) \uc774\uc678\uc758 \ub2e4\ub978\uc8fc\ub098 \uc900\uc8fc\uc5d0 \uac70\uc8fc\ud560 \uc758\ub3c4\ub97c \uac00\uc9c0\uace0 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p>\ub354 \ub9ce\uc740 \uc815\ubcf4\ub97c \uc6d0\ud558\uc2dc\uba74, \uc544\ub798\uc758 \uc6f9\uc0ac\uc774\ud2b8\ub97c \ucc38\uc870\ud558\uc2dc\uae38 \ubc14\ub78d\ub2c8\ub2e4:<\/p>\n<p><a href=\"https:\/\/www.canada.ca\/en\/immigration-refugees-citizenship\/news\/2021\/05\/applications-open-tomorrow-for-new-pathway-to-permanent-residency-for-over-90000-essential-temporary-workers-and-international-graduates-of-a-canad.html\">https:\/\/www.canada.ca\/en\/immigration-refugees-citizenship\/news\/2021\/05\/applications-open-tomorrow-for-new-pathway-to-permanent-residency-for-over-90000-essential-temporary-workers-and-international-graduates-of-a-canad.html<\/a><\/p>\n<p><a href=\"https:\/\/www.canada.ca\/en\/immigration-refugees-citizenship\/campaigns\/tr-pr.html?utm_campaign=trtopr2021&amp;utm_medium=email&amp;utm_source=trtopr2021&amp;utm_con