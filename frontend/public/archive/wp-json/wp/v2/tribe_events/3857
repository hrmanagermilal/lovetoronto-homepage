744 \uc801\uac8c \ubc1b\ub294 \uc7a5\uc810\uc744 \uc0b4\ub824, \uac15\uc0ac\ubd84\ub4e4\uc774 \ud55c\uad6d(\ud55c\uad6d \ubd80\ubd80\ud559\uad50 \uac15\uc0ac\/ 4\uc77c\ucc28)\/\ubbf8\uad6d(\ubbf8\uc8fc \ubd80\ubd80\ud559\uad50 \uac15\uc0ac\/1\uc77c\ucc28)\/\uce90\ub098\ub2e4(Love Family \uac15\uc0ac\/2,3\uc77c\ucc28)\uc5d0\uc11c \uac15\uc758\ub97c \uc9c4\ud589\ud558\uac8c \ub429\ub2c8\ub2e4. \uc9c0\uc6d0\uc790\ub4e4\ub3c4 \uc5ec\ub7ec \uc9c0\uc5ed\uc5d0\uc11c \ub9ce\uc774 \ucc38\uc5ec\ud558\uae30\ub97c \uae30\ub300\ud569\ub2c8\ub2e4.<br \/>\n\ud504\ub85c\uadf8\ub7a8 \ub0b4\uc6a9(\ucca8\ubd80 \ud3ec\uc2a4\ud130 \ucc38\uc870)\uc740 \uc804\ubb38 \uac15\uc0ac\ub4e4\uc758 \uac15\uc758\uc640 \uc18c\uadf8\ub8f9 \ub098\ub214, \ubd80\ubd80\uac04 \uc5d1\ud2f0\ube44\ud2f0 \ub4f1\uc73c\ub85c \uad6c\uc131\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.&#8217;<\/p>\n<p><strong><a href=\"https:\/\/lovetoronto.org\/wp-content\/uploads\/2020\/09\/\ubd80\ubd80\ub370\uc774\ud2b8\uc2e0\uccad\uc11c.pdf\">[\ub2e4\uc6b4\ub85c\ub4dc] \ubd80\ubd80\ub370\uc774\ud2b8\uc2e0\uccad\uc11c\u00a0<\/a><\/strong><\/p>\n<p>&nbsp;<\/p>\n","protected":false},"excerpt":{"rendered":"On-line workshop for Married couple","protected":false},"author":1,"featured_media":3858,"template":"","meta":{"give_campaign_id":0,"_tribe_events_status":"","_tribe_events_status_reason":"","footnotes":""},"tags":[],"tribe_events_cat":[],"class_list":["post-3857","tribe_events","type-tribe_events","status-publish","has-post-thumbnail","hentry"],"aioseo_notices":[],"aioseo_head":"\n\t\t<!-- All in One SEO 5.0.0.1 - aioseo.com -->\n\t<meta name=\"description\" content=\"On-line workshop for Married couple\" \/>\n\t<meta name=\"robots\" content=\"max-image-preview:large\" \/>\n\t<meta name=\"author\" content=\"lovetoronto\"\/>\n\t<link rel=\"canonical\" href=\"https:\/\/lovetoronto.org\/event-item\/%ec%98%a8%eb%9d%bc%ec%9d%b8%eb%b6%80%eb%b6%80%eb%8d%b0%ec%9d%b4%ed%8a%b8\/\" \/>\n\t<meta name=\"generator\" content=\"All in One SEO (AIOSEO)