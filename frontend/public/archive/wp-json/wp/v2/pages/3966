                 <h4>\n                    <a href=\"https:\/\/lovetoronto.org\/lawbook-item\/%eb%b3%84%ea%b1%b0%ec%99%80-%ec%9d%b4%ed%98%bc-%ec%9e%90%eb%85%80%ec%9d%98-%ec%9d%98%ec%82%ac-%ea%b2%b0%ec%a0%95%ea%b3%bc-%ec%96%91%ec%9c%a1-%ec%8b%9c%ea%b0%84\/\">\ubcc4\uac70\uc640 \uc774\ud63c: \uc790\ub140\uc758 \uc758\uc0ac \uacb0\uc815\uacfc \uc591\uc721 \uc2dc\uac04<\/a>\n                  <\/h4>\n                  <p>\ubd80\ubaa8\uac00 \ubcc4\uac70\ud558\uac70\ub098 \uc774\ud63c \ud560 \ub54c, \uc544\uc774\ub4e4\uc774 \uc0b4 \uacf3, \uc790\ub140\uac00 \uac01 \ubd80\ubaa8\uc640 \ud568\uaed8 \ubcf4\ub0bc \uc2dc\uac04, \uc790\ub140 \uc591\uc721\uc5d0 \ub300\ud55c \uc8fc\uc694 \uacb0\uc815\uc744 \ud560 \uc0ac\ub78c\uc744 \ud3ec\ud568\ud558\ub294 \uc721\uc544 \uacc4\ud68d\uc744 \ub9c8\ub828\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \uac04\ud589\ubb3c\uc740 \ub2e4\ub978 \uc591\uc721\uad8c \ubc0f \uc811\uadfc \uc57d\uc815, \uc591\uc721 \uacc4\ud68d\uc744 \uc791\uc131\ud558\ub294 \ubc29\ubc95, \ubd80\ubaa8\uac00 \ub3d9\uc758 \ud560 \uc218 \uc5c6\ub294 \uacbd\uc6b0 \ud310\uc0ac\uc640 \uc911\uc7ac\uc790\uac00 \uc774\ub7ec\ud55c \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ubc29\ubc95\uc5d0 \ub300\ud574 \uc124\uba85\ud569\ub2c8\ub2e4. \uc774 \uac04\ud589\ubb3c\uc740 \ubc95\uc801 \ub3c4\uc6c0\uc744\ubc1b\uc744 \uc218\uc788\ub294 \uacf3\uc5d0 \ub300\ud55c \uc790\uc138\ud55c \uc815\ubcf4\uc640 \ud568\uaed8 \uc81c\uacf5\ud569\ub2c8\ub2e4.\r\n<div class=\"project-link\">\r\n<a class=\"grop-btn project-link-en\" href=\"https:\/\/www.cleo.on.ca\/en\/publications\/custodyaccess\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n<span>\uc6d0\ubb38\ubcf4\uae30<\/span>\r\n<\/a>\r\n<a class=\"grop-btn project-link-down\" href=\"https:\/\/lovetoronto.org\/download\/3362\/\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n<span>\ub2e4\uc6b4\ubc1b\uae30<\/span>\r\n<\/a>\r\n<\/div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_bt