{"id":2872,"date":"2020-03-25T16:27:39","date_gmt":"2020-03-25T16:27:39","guid":{"rendered":"https:\/\/lovetoronto.org\/?page_id=2872"},"modified":"2026-07-09T17:50:59","modified_gmt":"2026-07-09T17:50:59","slug":"faq","status":"publish","type":"page","link":"https:\/\/lovetoronto.org\/faq\/","title":{"rendered":"\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38 &#8211; \ub7ec\ube0c\ud1a0\ub860\ud1a0"},"content":{"rendered":"<div class=\"wpb-content-wrapper\"><p>[vc_row overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1586888861904{padding-top: 40px !important;padding-bottom: 40px !important;}&#8221;][vc_column][vc_wp_custommenu nav_menu=&#8221;63&#8243; el_class=&#8221;submenu_faq&#8221;][\/vc_column][\/vc_row][vc_row overlay_dotted=&#8221;&#8221;][vc_column css=&#8221;.vc_custom_1507715160194{padding-right: 30px !important;}&#8221; el_class=&#8221;grop-col-padding-none&#8221;]<div class=\"panel-group\" id=\"grop-6ad190cfc64081\" role=\"tablist\" aria-multiselectable=\"true\"><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190cfc64080\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190cfc64081\" href=\"#grop-faq-6ad190cfc64080\" aria-controls=\"grop-faq-6ad190cfc64080\">\ud639\uc2dc \ud1a0\ub860\ud1a0\uc5d0 \uc0ac\ub294 \uc8fc\ubbfc\ub4e4\ub9cc \uc774 \ub2e8\uccb4 \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\ub294 \uac74\uac00\uc694?<\/a><\/h4><\/div><div id=\"grop-faq-6ad190cfc64080\" class=\"panel-collapse collapse  in\" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190cfc64080\"><div class=\"panel-body  grop-faq-body\">[vc_column_text]\ud1a0\ub860\ud1a0\uc5d0 \uac70\uc8fc\ud558\uc2dc\ub294 \ubd84 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc9c0\uc5ed\uc5d0 \uc0c1\uad00\uc5c6\uc774 \uc800\ud76c \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c\ub85c \uc624\ud0c0\uc640, \ub098\uc774\uc544\uac00\ub77c, \ub7f0\ub358 \ub4f1 \uba40\ub9ac\uc11c \uc800\ud76c\ub97c \ucc3e\uc544\uc624\uc2dc\ub294 \ubd84\ub4e4\ub3c4 \uacc4\uc2ed\ub2c8\ub2e4.<br \/>\n\uc800\ud76c\uac00 \ud1a0\ub860\ud1a0\uc5d0 \uc704\uce58\ud558\uace0 \uc788\uae30\uc5d0 \ub7ec\ube0c\ud1a0\ub860\ud1a0\ub77c\ub294 \uc774\ub984\uc744 \ubd99\uc600\uc2b5\ub2c8\ub2e4. \uc6d0\ub798\ub294 \ub7ec\ube0c\uc624\ud0c0\uc640, \ub7ec\ube0c\ud574\ubc00\ud134, \ub7ec\ube0c\ubaac\ud2b8\ub9ac\uc62c \ucc98\ub7fc \uc5ec\ub7ec \uc9c0\uc5ed\uc5d0 \uac19\uc740 \uc720\ud615\uc758 \ub2e8\uccb4\ub4e4\uacfc \uc5f0\ub300\ud558\uc5ec \ub3d9\uc77c\ud55c \uc0ac\uc5ed\uc744 \ud560\uc218 \uc788\uae30\ub97c \ubc14\ub77c\uba70 \uc774\ub984\uc744 \uadf8\ub807\uac8c \uc9c0\uc5c8\uc2b5\ub2c8\ub2e4.[\/vc_column_text]<\/div><\/div><\/div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190cfc64081\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190cfc64081\" href=\"#grop-faq-6ad190cfc64081\" aria-controls=\"grop-faq-6ad190cfc64081\">``\ub7ec\ube0c\ud1a0\ub860\ud1a0``\uc758 \ucde8\uc9c0\ub294 \ubb34\uc5c7\uc774\uace0, \uc5b4\ub5a4 \ud65c\ub3d9\uc744 \ud558\ub294 \uacf3\uc778\uc9c0\uc694?<\/a><\/h4><\/div><div id=\"grop-faq-6ad190cfc64081\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190cfc64081\"><div class=\"panel-body  grop-faq-body\">[vc_column_text]\ub7ec\ube0c\ud1a0\ub860\ud1a0\ub294 2016\ub144\uc5d0 \ubc00\uc54c\uad50\ud68c\uac00 \uad50\ud68c\uc548\uc5d0\uc11c \uc798 \ud6c8\ub828\ub41c \uc0ac\ub791\uacfc \uc12c\uae40\uc758 \uc815\uc2e0\uc744 \uc774\ubbfc\uc0dd\ud65c\ub85c \ud798\ub4e0 \ud55c\uc778\ub3d9\ud3ec\uc0ac\ud68c\uc5d0 \uc2e4\ucc9c\ud558\uc790\ub294 \ucde8\uc9c0\ub85c \uc124\ub9bd\ud55c \ube44\uc601\ub9ac \uc790\uc120\ub2e8\uccb4\uc785\ub2c8\ub2e4. \uadf8 \ucde8\uc9c0\uc5d0 \ub530\ub77c \uad50\ud68c\uc758 \uc774\ub984 \ub300\uc2e0 \u201c\ub7ec\ube0c\ud1a0\ub860\ud1a0\u201d\ub77c\ub294 \uc774\ub984\uc73c\ub85c \ud55c\uc778\uc0ac\ud68c\uc5d0\uc11c \uc5b4\ub835\uace0 \ud798\ub4e0 \ubd84\ub4e4\uc744 \ub3d5\uace0 \uc788\uc2b5\ub2c8\ub2e4.<br \/>\n\ub7ec\ube0c\ud1a0\ub860\ud1a0\ub294 \ub2e4\ub978 \ud55c\uc778 \ub2e8\uccb4\ub4e4\uc774 \uc81c\uacf5\ud558\ub294 \uc11c\ube44\uc2a4\uc758 \uacf5\ubc31\uc744 \uba54\uc6b8 \uc218 \uc788\ub294 \uc0ac\uc5c5\ub4e4 \uc911 \u201c\uc9c4\ub8cc, \uc815\uc2e0\uac74\uac15\uc0c1\ub2f4, \ubc95\ub960\uc0c1\ub2f4, ADP\uc9c0\uc6d0\u201d\uc758 \ub124 \uac00\uc9c0 \uc0ac\uc5c5\uc744 \uc120\uc815\ud558\uc5ec \uc81c\uacf5\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc911\uc5d0\uc11c \ud2b9\ud788 \uc9c4\ub8cc, \uc815\uc2e0\uac85\uac15\uc0c1\ub2f4, \ubc95\ub960\uc0c1\ub2f4\uc740 \uc804\ubb38\uac00\ub4e4\uc758 \ub3c4\uc6c0 \uc5c6\uc774\ub294 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\ub294 \uac83\uc774 \ubd88\uac00\ub2a5\ud55c\ub370, \ub9c8\uce68 \uc774 \uc77c\uc744 \uc704\ud574 \uc790\uc6d0\ud558\uc5ec \uc12c\uae30\uc2dc\ub294 \uc804\ubb38\uac00\ub4e4 \ub355\ubd84\uc5d0 \uc800\ud76c \ub7ec\ube0c\ud1a0\ub860\ud1a0\uac00 \ub2e4\ub978 \ud55c\uc778 \ub2e8\uccb4\uc5d0\uc11c\ub294 \ubcf4\uae30 \ub4dc\ubb38 \ucc38 \uadc0\ud55c \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.[\/vc_column_text]<\/div><\/div><\/div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190cfc64082\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190cfc64081\" href=\"#grop-faq-6ad190cfc64082\" aria-controls=\"grop-faq-6ad190cfc64082\">\ubc95\ub960\uc11c\ube44\uc2a4\ub97c \ud1b5\ud574\uc11c \uc5b4\ub5a4 \ub3c4\uc6c0\uc744 \uc8fc\uc2dc\ub098\uc694?<\/a><\/h4><\/div><div id=\"grop-faq-6ad190cfc64082\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190cfc64082\"><div class=\"panel-body  grop-faq-body\">[vc_column_text]\uce90\ub098\ub2e4\uc5d0 \uc0b4\uba74\uc11c \uc784\ub300\ucc28, \uac00\uc815, \uc9c1\uc7a5, \uad50\ud1b5\uc0ac\uace0 \ub4f1 \ubc95\ub960\uc801\uc778 \ubb38\uc81c\ub97c \ub9cc\ub0ac\uc744 \uacbd\uc6b0 \uc774\ub7f0 \ubb38\uc81c\ub4e4\uc744 \uc81c\ub300\ub85c \uc774\ud574\ud558\uace0 \uc5b4\ub5a4 \ubc29\ubc95\uacfc \uc808\ucc28\ub97c \ud1b5\ud574 \ud574\uacb0\ud560 \uc218 \uc788\ub294\uc9c0\ub97c \uc815\ud655\ud558\uac8c \ud30c\uc545\ud558\ub294 \uac83\uc774 \uae09\uc120\ubb34\uc785\ub2c8\ub2e4. \uc774\ub7f0 \uae09\uc120\ubb34\ub97c \uc5b4\ub5bb\uac8c \ud574\uacb0\ud560 \uc9c0\ub97c \ub3c4\uc640\ub4dc\ub9ac\ub294 \uac83\uc774 \uc800\ud76c \ub7ec\ube0c\ud1a0\ub860\ud1a0 \ubc95\ub960\uc0c1\ub2f4\uc774 \ucd94\uad6c\ud558\ub294 \uc5ed\ud560\uc785\ub2c8\ub2e4. \ubc95\ub960\uc0c1\ub2f4\uc744 \uc704\ud574\uc11c \ubcc0\ud638\uc0ac, \ubc95\ubb34\uc0ac\ub2d8\uaed8\uc11c \ub204\uad6c(\uacbd\ucc30, \ubcc0\ud638\uc0ac, \ubc95\ubb34\uc0ac\u2026)\ub97c \ucc3e\uc544\uac00\uc11c \uc5b4\ub5a4 \ub3c4\uc6c0\uc744 \ubc1b\uc544\uc57c \ud558\ub294\uc9c0 \uac00\uc774\ub4dc \ub77c\uc778\uc744 \uc81c\uc2dc\ud574 \ub4dc\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.<br \/>\n\ubc95\ub960\uc0c1\ub2f4 \uc2e0\uccad\uc740 \uc774\uba54\uc77c\ub85c \uc811\uc218 \ubc1b\uc2b5\ub2c8\ub2e4. \ubb38\uc758\ud558\uc2dc\ub294 \ub2f9\uc0ac\uc790\uc640 \uc0c1\ub300\ubc29\uc758 \uc778\uc801\uc0ac\ud56d\uacfc \ubb38\uc758\ud558\uace0\uc790 \ud558\ub294 \ub0b4\uc6a9\uc744 \uc0c1\uc138\ud788 \uc801\uc73c\ub85c \uc774\uba54\uc77c\ub85c \ubcf4\ub0b4\uc8fc\uc2dc\uba74, \ubcc0\ud638\uc0ac\ub2d8\uaed8 \uc804\ub2ec\ud574 \ub4dc\ub9ac\uace0, \ubcc0\ud638\uc0ac\ub2d8\uaed8\uc11c \uc774\uba54\uc77c, \uc804\ud654, \ub610\ub294 \uba74\ub2f4\uc744 \ud1b5\ud574\uc11c \ub2f5\ubcc0\uc744 \uc8fc\uc2ed\ub2c8\ub2e4.<br \/>\n\ub9ce\uc740 \ubd84\ub4e4\uc774 \ub2f5\ub2f5\ud55c \ub9c8\uc74c\uc5d0 \uc5ec\ub7ec \ubcc0\ud638\uc0ac\ub4e4\uc5d0\uac8c \uac19\uc740 \uc790\ubb38\uc744 \uad6c\ud558\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7f4 \uacbd\uc6b0 \ud55c \ubcc0\ud638\uc0ac\uac00 \ub2f9\uc0ac\uc790\uc640 \uc0c1\ub300\ubc29 \uc591\uce21\uc5d0\uac8c \uc790\ubb38\uc744 \ud558\uac8c \ub420 \uacbd\uc6b0\uc5d0\ub294 \ubc95\uc5d0 \uc800\ucd09\ub418\uac8c \ub418\ubbc0\ub85c, \ubb38\uc758\ud558\uc2e4 \ub54c\uc5d0\ub294 <strong>\ubc18\ub4dc\uc2dc \ubcf8\uc778 \uc815\ubcf4\uc640 \uc0c1\ub300\ubc29\uc758 \uc815\ubcf4\ub97c \uc815\ud655\ud558\uac8c \uae30\ub85d\ud558\uc5ec\uc57c \uc790\ubb38\uc744 \ubc1b\uc73c\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/strong>[\/vc_column_text]<\/div><\/div><\/div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190cfc64083\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190cfc64081\" href=\"#grop-faq-6ad190cfc64083\" aria-controls=\"grop-faq-6ad190cfc64083\">\uc815\uc2e0\uac74\uac15\uc0c1\ub2f4\uc11c\ube44\uc2a4\ub97c \ud1b5\ud574\uc11c \uc5b4\ub5a4 \ub3c4\uc6c0\uc744 \uc8fc\uc2dc\ub098\uc694?<\/a><\/h4><\/div><div id=\"grop-faq-6ad190cfc64083\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190cfc64083\"><div class=\"panel-body  grop-faq-body\">[vc_column_text]\uc774\ubbfc\uc0dd\ud65c\ub85c \uc778\ud574 \ub9ce\uc740 \ubd84\ub4e4\uc774 \uc815\uc2e0\uac74\uac15 \ubb38\uc81c\ub85c \uc5b4\ub824\uc6c0\uc744 \uacaa\uace0 \uc788\uc9c0\ub9cc, \uc5b8\uc5b4\uc758 \uc7a5\ubcbd, \ud55c\uad6d\uc801\uc778 \uc815\uc11c\ub85c \uc778\ud574 \uc790\uc2e0\uc758 \ubb38\uc81c\ub97c \ub4e4\uc5b4\ub0b4\uc5b4 \ub193\uace0 \uc0c1\ub2f4\uc0ac \ub610\ub294 \uc758\uc0ac\ub97c \ucc3e\uc544\uac00\uc9c0 \ubabb\ud558\ub294 \ubd84\uc774 \ub9ce\uc774 \uacc4\uc2e4 \uac83\uc73c\ub85c \ucd94\uc815\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub798\uc11c \ub7ec\ube0c\ud1a0\ub860\ud1a0\ub294 \ub124 \ubd84\uc758 \uacf5\uc778\ub41c \uc2ec\ub9ac\uce58\ub8cc \uc0c1\ub2f4\uc0ac\ub2d8\uacfc \ud611\ub825 \uacc4\uc57d\uc744 \ub9fa\uc5b4 \ud560\uc778\ub41c \uc0c1\ub2f4\ube44\uc6a9\uc73c\ub85c \uc0c1\ub2f4\uc744 \uc81c\uacf5\ud574 \uc8fc\uc2dc\uace0, \ub0b4\ub2f4\uc790\ub4e4\ub85c\ubd80\ud130 \ubb38\uc758\uac00 \uc624\uba74 \ud611\ub825\uc0c1\ub2f4\uc0ac\ub2d8\ub4e4\uc5d0\uac8c \ub0b4\ub2f4\uc790\ub97c \ubcf4\ub0b4\ub4dc\ub9ac\ub294 \uc2dc\uc2a4\ud15c\uc73c\ub85c \uc0c1\ub2f4\uc11c\ube44\uc2a4\ub97c \uc6b4\uc601\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<br \/>\n\ub0b4\ub2f4\uc790\uac00 \ud559\uc0dd\ubcf4\ud5d8 \ub610\ub294 \uc9c1\uc7a5\ubcf4\ud5d8\uc774 \uc788\ub294 \uacbd\uc6b0\ub294 \ubcf4\ud5d8\uc5d0\uc11c \uc0c1\ub2f4\ube44\uc6a9\uc744 \uc9c0\uc6d0\ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc774\ub7f0 \ubcf4\ud5d8\uc774 \uc5c6\ub294 \ubd84\ub4e4\uc774 \uacbd\uc81c\uc801\uc778 \ubd80\ub2f4\uc73c\ub85c \uc778\ud574 \uc0c1\ub2f4\uc744 \ubc1b\uae30 \ud798\ub4e0 \uacbd\uc6b0\uc5d0\ub294 \ub7ec\ube0c\ud1a0\ub860\ud1a0\uac00 \uc0c1\ub2f4\ube44\uc6a9\uc758 \uc77c\ubd80\ubd84\uc744 \uc9c0\uc6d0\ud574 \ub4dc\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. 3\uc790 \ubaa8\ub450\uac00 \uc0c1\ub2f4\uc744 \uc704\ud574\uc11c \uc790\uc2e0\uc758 \ubaab\uc744 \ubd84\ub2f4\ud568\uc73c\ub85c\uc368, \uc11c\ub85c \ucc45\uc784\uac10\uc744 \uac16\uace0 \ub354\uc6b1 \uc131\uc2e4\ud788 \uc0c1\ub2f4\uc5d0 \uc784\ud558\uc5ec \uc88b\uc740 \uacb0\uacfc\ub97c \uac00\uc838 \uc624\uace0 \uc788\uc2b5\ub2c8\ub2e4.[\/vc_column_text]<\/div><\/div><\/div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190cfc64084\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190cfc64081\" href=\"#grop-faq-6ad190cfc64084\" aria-controls=\"grop-faq-6ad190cfc64084\">\ub7ec\ube0c\ud1a0\ub860\ud1a0\uc640 \ud568\uaed8 \ud574\uc8fc\ub294 \ubd84\ub4e4\uc740 \uc5b4\ub5a4 \ubd84\ub4e4? \ud55c\uc778 \uc790\uc6d0\ubd09\uc0ac\uc790\ub77c\uace0 \ubcf4\uba74 \ub418\ub098\uc694?<\/a><\/h4><\/div><div id=\"grop-faq-6ad190cfc64084\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190cfc64084\"><div class=\"panel-body  grop-faq-body\">[vc_column_text]\ud55c\uc778\ubd09\uc0ac\uc790 \ub9de\uc2b5\ub2c8\ub2e4. \ubd09\uc0ac\uc790 \uc911\uc5d0\uc11c\ub3c4 \ud2b9\ubcc4\ud788 \uc804\ubb38\uc9c1\uc5d0 \uc885\uc0ac\ud558\uc2dc\uba74\uc11c \ubcf8\uc778\uc758 \uc804\ubb38\ubd84\uc57c\uc758 \uc9c0\uc2dd\uacfc \uae30\uc220\uc744 \uac00\uc9c0\uace0 \ubd09\uc0ac\ud558\uc2dc\ub294 \ud2b9\ubcc4\ud55c \ubd09\uc0ac\uc790\ub77c\uace0 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud55c\uad6d\uacfc \ub2ec\ub9ac \uce90\ub098\ub2e4\uc5d0\uc11c\ub294 \uc9c1\uc5c5\uc758 \uac00\uce58\ub97c \uc2dc\uac04\ub2f9 \uae09\uc5ec\ub85c \uacc4\uc0b0\ud558\ub294\ub370, \ubcc0\ud638\uc0ac\uc640 \uc758\uc0ac\ub4e4\uc758 \uc2dc\uac04\ub2f9 \uac00\uce58\ub294 \ub9e4\uc6b0 \ub192\uc2b5\ub2c8\ub2e4. \ud45c\ud604\uc774 \uc880 \uc5b4\uc0c9\ud558\uae30\ub294 \ud558\uc9c0\ub9cc \uc774 \ubd84\ub4e4\uc758 \ud55c\uc2dc\uac04\uc774 \uc800\uc758 \ud55c \uc2dc\uac04\ubcf4\ub2e4 \uba87\ubc30\uc758 \uac00\uce58\uac00 \uc788\ub2e4\ub294 \uacc4\uc0b0\uc785\ub2c8\ub2e4. \uadf8\ub7fc\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \uc774 \ubd84\ub4e4\uc774 \uc790\uc2e0\uc758 \uc2dc\uac04\uc744 \ub0b4\uc5b4\uc11c \ubd09\uc0ac\uc5d0 \ucc38\uc5ec\ud558\uc2dc\ub2c8 \ucc38 \uadc0\ud55c \uc77c\uc774 \uc544\ub2d0 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.[\/vc_column_text]<\/div><\/div><\/div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190cfc64085\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190cfc64081\" href=\"#grop-faq-6ad190cfc64085\" aria-controls=\"grop-faq-6ad190cfc64085\">2016\ub144 3\uc6d4 \ubc1c\uc871\ud6c4 \uc5ed\uc0ac\uac00 \uc624\ub798\ub410\ub2e4\uace0 \ud560 \uc218\ub294 \uc5c6\uc9c0\ub9cc \uadf8\ub798\ub3c4 \uc870\uae08\uc529 \uc5f4\ub9e4\ub97c \ub9fa\uace0 \uc788\uc744 \uac83 \uac19\uc544\uc694?<\/a><\/h4><\/div><div id=\"grop-faq-6ad190cfc64085\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190cfc64085\"><div class=\"panel-body  grop-faq-body\">[vc_column_text]\uc22b\uc790\uc801\uc73c\ub85c \ub9ce\uc740 \uc131\uacfc\ub97c \uac70\ub450\uc5c8\ub2e4\uae30 \ubcf4\ub2e4\ub294 \uc0ac\uc5ed\uc758 \ud2b9\uc218\uc131\uc774 \ud070 \uc131\uacfc\uc778 \uac83 \uac19\uc2b5\ub2c8\ub2e4. \uc22b\uc790\uc801\uc778 \uc131\uacfc\uba74\uc5d0\uc11c \ubcf4\uba74, \uc800\ud76c \uc0ac\uc5ed\uc758 \ud2b9\uc131\uc0c1 \uc218\uc694\uc640 \uacf5\uae09\uc744 \uc870\uc808\ud558\uae30 \uc5b4\ub824\uc6b4 \uc774\uc720\ub85c \ub9ce\uc740 \ubd84\ub4e4\uc5d0\uac8c \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\ub294\ub370 \ud55c\uacc4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ubc18\uba74\uc5d0 \ub2e4\ub978 \uc5b4\ub290 \uae30\uad00\uc5d0\uc11c\ub3c4 \uc81c\uacf5\ud558\uace0 \uc788\uc9c0 \uc54a\ub294 \uc11c\ube44\uc2a4\ub97c \uc800\ud76c\uac00 \uc81c\uacf5\ud558\ubbc0\ub85c\uc368, \ud55c\uc778\uc0ac\ud68c\uc5d0\uc11c \ubd80\uc871\ud55c \uc11c\ube44\uc2a4\uc758 \uacf5\ubc31\uc744 \uba54\uc6b0\uace0, \ub3c4\uc6c0\uc774 \uc808\uc2e4\ud788 \ud544\uc694\ud558\uc2e0 \ubd84\ub4e4\uc5d0\uac8c \ub3c4\uc6c0\uc744 \ub4dc\ub9ac\uac8c \ub418\uc5c8\uc73c\ub2c8, \uc774\uac83\uc774 \ucc38 \uc758\ubbf8\uc788\ub294 \uc131\uacfc\ub77c\uace0 \uc0dd\uac01\ub429\ub2c8\ub2e4.[\/vc_column_text]<\/div><\/div><\/div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190cfc64086\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190cfc64081\" href=\"#grop-faq-6ad190cfc64086\" aria-controls=\"grop-faq-6ad190cfc64086\">\uc7ac\uc815\uc801 \ubd80\ub2f4\uc774 \uc0c1\ub2f9\ud560\ud150\ub370 \ud6c4\uc6d0\uc744 \ud574\uc8fc\ub294 \uacf3\uc774 \uc788\ub294\uc9c0, \ubd09\uc0ac\uc790 \ubaa8\uc9d1\uc5d0 \uc5b4\ub824\uc6c0\uc740 \uc5c6\ub294\uc9c0\ub3c4 \uad81\uae08\ud558\ub124\uc694?<\/a><\/h4><\/div><div id=\"grop-faq-6ad190cfc64086\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190cfc64086\"><div class=\"panel-body  grop-faq-body\">[vc_column_text]\uc55e\uc5d0\uc11c \uc7a0\uc2dc \uc5b8\uae09\ud55c \uac83\ucc98\ub7fc \ubc00\uc54c\uad50\ud68c\uac00 \ub7ec\ube0c\ud1a0\ub860\ud1a0\uc758 \ubaa8\ud0dc\ub85c\uc11c \ud604\uc7ac\uae4c\uc9c0\ub294 \uc9c0\uc6d0\uc744 \uc544\ub07c\uc9c0 \uc54a\uace0 \uc788\uc2b5\ub2c8\ub2e4\ub9cc, \uace7 \uacbd\uc81c\uc801\uc73c\ub85c \ub3c5\ub9bd\ud558\uc5ec \uc644\uc804\ud788 \uc790\uc0dd\ud560 \uc218 \uc788\ub294 \uc790\uc120\ub2e8\uccb4\ub85c \uc11c\uac8c \ub418\ub294 \uac83\uc774 \uc800\ud76c\ub4e4\uc758 \uc911\uc694\ud55c \uacfc\uc81c\uc785\ub2c8\ub2e4. \uc800\ud76c \uc0ac\uc5ed\uc758 \ud2b9\uc131\uc0c1 \uce90\ub098\ub2e4 \uc815\ubd80\ub85c\ubd80\ud130 \uc6b4\uc601\uc790\uae08\uc744 \uc9c0\uc6d0\ubc1b\ub294\ub370 \uc5b4\ub824\uc6c0\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub530\ub77c\uc11c \uc5ec\ub7ec\ubd84\uc758 \ud6c4\uc6d0\uc774 \ud070 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4. \ub7ec\ube0c\ud1a0\ub860\ud1a0 \ud648\ud398\uc774\uc9c0\ub97c \uac1c\ud3b8\ud558\uba74\uc11c \uc628\ub77c\uc778 \ub3c4\ub124\uc774\uc158\ub3c4 \ucd94\uac00\ud558\uc600\uc2b5\ub2c8\ub2e4. \ub9ce\uc740 \ubd84\ub4e4\uc758 \ud6c4\uc6d0\uc744 \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4.[\/vc_column_text]<\/div><\/div><\/div><\/div>[\/vc_column][\/vc_row]<\/p>\n<\/div>","protected":false},"excerpt":{"rendered":"[vc_row overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1586888861904{padding-top: 40px !important;padding-bottom: 40px !important;}&#8221;][vc_column][vc_wp_custommenu nav_menu=&#8221;63&#8243; el_class=&#8221;submenu_faq&#8221;][\/vc_column][\/vc_row][vc_row overlay_dotted=&#8221;&#8221;][vc_column css=&#8221;.vc_custom_1507715160194{padding-right: 30px !important;}&#8221; el_class=&#8221;grop-col-padding-none&#8221;][\/vc_column][\/vc_row]","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","pin