\uc8fc \uc678\uc758 \uc9c0\uc5ed\uc5d0 \uac70\uc8fc\ud558\ub294 \ubd84\ub4e4\uc5d0\uac8c\ub294 \uc800\ud76c \ubcc0\ud638\uc0ac\uc640 \ubc95\ubb34\uc0ac\ub2d8\uc774 \ubc95\ub960 \uc0c1\ub2f4\uc744 \uc81c\uacf5\ud560 \uc218 \uc5c6\uc73c\uba70, \uac70\uc8fc \uc9c0\uc5ed\uc5d0\uc11c \ub2e4\ub978 \ubc95\ub960 \uc11c\ube44\uc2a4\ub97c \ucc3e\uc544\ubcf4\uc154\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p><strong>2. \ubb34\ub8cc \uc0c1\ub2f4:<\/strong> \ubc95\ub960 \uc0c1\ub2f4\uc740 1\ud68c\ub9cc \ubb34\ub8cc\ub85c \uc81c\uacf5\ub429\ub2c8\ub2e4. 1\ud68c \uc774\uc0c1\uc758 \uc0c1\ub2f4\uc774 \ud544\uc694\ud560 \uacbd\uc6b0, \ub2f4\ub2f9 \ubcc0\ud638\uc0ac\ub098 \ubc95\ubb34\uc0ac\ub2d8\uacfc \uc0c1\ub2f4 \ube44\uc6a9\uc5d0 \ub300\ud574 \uc0c1\uc758\ud558\uc154\uc57c \ud569\ub2c8\ub2e4. (\ub2e8, \uac00\uc815\ubc95, \uc131\ubc94\uc8c4\uc640 \uc0c1\ub2f4 \ub0b4\uc6a9\uc5d0 \ub530\ub77c \ubb34\ub8cc \uc0c1\ub2f4\uc774 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.)<\/p>\n<p><strong>3. \uc0c1\ub300\ubc29 \uc815\ubcf4 \uc785\ub825:<\/strong> \ubc95\ub960 \uc0c1\ub2f4 \uc2e0\uccad \uc2dc\uc5d0\ub294 \ubc18\ub4dc\uc2dc \uc0c1\ub300\ubc29 \uc815\ubcf4\ub97c \uc785\ub825\ud558\uc154\uc57c \uc0c1\ub2f4\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 conflict of interest\ub97c \ud655\uc778\ud558\uae30 \uc704\ud55c \uc808\ucc28\uc77c \ubfd0, \uc785\ub825\ud558\uc2e0 \uc815\ubcf4\ub294 \uc808\ub300\ub85c \ub2e4\ub978 \uc6a9\ub3c4\ub85c \uc0ac\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uc774 \uc810\uc744 \ucc38\uace0\ud558\uc2dc\uc5b4 \ud544\uc694\ud55c \ubc95\ub960 \uc0c1\ub2f4\uc744 \uc2e0\uccad\ud574\uc8fc\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.<\/p>\n<p>\ubc95\ub960 \uc790\ubb38\uc5d0 \uad00\ud55c \ub2f5\uc744 \ucc3e\uc73c\uc2dc\ub294 \uacbd\uc6b0, CLEO\uc5d0\uc11c \uac1c\uc124\ud55c Steps to Justice <a>https:\/\/stepstojustice.ca\/<\/a>\uc5d0\uc11c\ub3c4 \ucc3e\uc544\ubcf4\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p><a class=\"grop-btn grop-btn_overly grop-grop-oimtrm_btn\" href=\"\/contact\/?menu=contact-1\" ><span>\ubc95\ub960 \uc0c1\ub2f4 \ubb38\uc758\ud558\uae30<\/span><\/a><\/div><\/div>[\/vc_column][\/vc_row][vc_row overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1586887724208{padding-top: 20px !important;padding-bottom: 20px !important;}&#8221;][vc_column el_id=&#8221;what_we_do_2&#8243;][vc_raw_html]JTNDZGl2JTIwaWQlM0QlMjJzZWN0aW9uXzIlMjIlMjBzdHlsZSUzRCUyMnBvc2l0aW9uJTNBJTIwYWJzb2x1dGUlM0IlMjB0b3AlM0ElMjAtMTAwcHglM0IlMjIlM0UlMEElMjZuYnNwJTNCJTBBJTNDJTJGZGl2JTNF[\/vc_raw_html]<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\"\n           data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"https:\/\/lovetoronto.org\/wp-content\/uploads\/2020\/03\/card_2.jpg\" alt=\"\" ><h5 class=\"text-center  grop-oimt_cption\"><\/h5><\/div><\/div><\/div><div class=\"grop-fix  grop-oimt_txt\"><h3>\uc815\uc2e0\uac74\uac15\uc0c1\ub2f4 \uc11c\ube44\uc2a4<\/h3><p class=\"grop-oimt_semi\">\uc774 \uc11c\ube44\uc2a4\ub294 \uc5b8\uc5b4\uc640 \ubb38\ud654\uc758 \uc7a5\ubcbd\uc73c\ub85c \uc778\ud574 \uce90\ub098\ub2e4 \uc9c4\ub8cc \uc2dc\uc2a4\ud15c\uc5d0 \uc811\uadfc\ud558\uc5ec \ub3c4\uc6c0\uc744 \ubc1b\uae30\uac00 \uc27d\uc9c0 \uc54a\uc740 \ud55c\uc778\ub4e4\uc5d0\uac8c \uc880\ub354 \uc27d\uac8c \uc0c1\ub2f4\uc744 \ubc1b\uc744 \uc218 \uc788\ub294 \uae30\ud68c\ub97c \uc81c\uacf5\ud558\uace0\uc790\ud558\uc5ec \ub9c8\ub828\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub7ec\ube0c \ud1a0\ub860\ud1a0 \uc815\uc2e0\uac74\uac15 \uc0c1\ub2f4\uc2e4\uc5d0\uc11c\ub294 \uc9c1\uc7a5 \ubc0f \uac00\uc815 \ub4f1 \ubaa8\ub4e0 \ub300\uc778\uad00\uacc4\ub4e4\uc744 \ud1b5\ud574\uc11c \ubc1b\ub294 \uc2a4\ud2b8\ub808\uc2a4\ub85c \uc778\ud574 \uc0dd\uae30\ub294 \ubd88\uc548, \uc6b0\uc6b8, \uc870\uc6b8, \ubd88\uba74\uc99d \ub4f1 \ub2e4\uc591\ud55c \uac1c\uc778\uc758 \uc815\uc2e0\uc801 \uac74\uac15\uc0c1\ud0dc\uc5d0 \uad00\ud574 \uc0c1\ub2f4\uc744 \ubc1b\uc73c\uc2e4 \uc218 \uc788\uace0, \ub54c\ub85c\ub294 \ubd80\ubd80\ubb38\uc81c, \uc790\ub140\uc640\uc758 \uad00\uacc4\ubb38\uc81c, \ud559\uc5c5, \ucde8\uc5c5 \ub4f1\uc758 \ubb38\uc81c\ub85c \uc778\ud574 \uc790\uc2e0\uc758 \uac10\uc815, \ud2b9\ud788 \ubd84\ub178\uc640 \uc2a4\ud2b8\ub808\uc2a4 \ub808\ubca8\uc744 \uc870\uc808\ud558\uc9c0 \ubabb\ud574\uc11c \uacaa\ub294 \uc77c\ub4e4\uc744 \uc0c1\ub2f4\ubc1b\uc73c\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p><p>\ub0b4\ub2f4\uc790\uac00 \ub7ec\ube0c\ud1a0\ub860\ud1a0 \ud648\ud398\uc774\uc9c0\ub97c \ud1b5\ud574 \uc0c1\ub2f4\uc744 \uc2e0\uccad\ud558\uba74, \uc0ac\ubb34\uac04\uc0ac\ub294 \ubcf4\ud5d8\uc720\ubb34, \uc0c1\ub2f4\uc758 \uae34\uae09\uc131, \ub0b4\ub2f4\uc790 \ubd80\ub2f4 \uac00\ub2a5 \ube44\uc6a9 \ub4f1\uc744 \ud30c\uc545\ud55c \ud6c4 \ub7ec\ube0c\ud1a0\ub860\ud1a0 \ud611\ub825 \uc0c1\ub2f4\uc0ac\ub2d8\uaed8 \ub0b4\ub2f4\uc790\ub97c \uc5f0\uacb0\ud574\ub4dc\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><strong>\ubcf4\ud5d8\uc774 \uc788\ub294 \uacbd\uc6b0<\/strong>: \uc0c1\ub2f4\ube44\uc6a9\uc774 \ucee4\ubc84\ub418\ub294 \ubcf4\ud5d8(\uc9c1\uc7a5, \ud559\uc0dd, \uac1c\uc778)\uc774 \uc788\ub294 \uacbd\uc6b0\ub294 \ubcf8\uc778\uc758 \ubcf4\ud5d8\uc774 Psychotherapist services\ub97c \uc9c0\uc6d0\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc154\uc57c \ud569\ub2c8\ub2e4. (\uc544\ub798 \ub9c1\ud06c \ucc38\uace0) OHIP, UHIP, \ud55c\uad6d\uc5d0\uc11c \uac00\uc785\ud55c \ub300\ubd80\ubd84\uc758 \uc720\ud559\uc0dd \ubcf4\ud5d8\uc740 \uadf8 \uc5b4\ub5a4 \uc815\uc2e0\uac74\uac15 \uc0c1\ub2f4 \uc11c\ube44\uc2a4\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ubcf8\uc778\uc758 \ubcf4\ud5d8\uc774 Psychotherapist services\ub97c \uc9c0\uc6d0\ud558\ub294 \uacbd\uc6b0 \uc2e0\uccad\uc11c\uc5d0 \ud45c\uc2dc\ud558\uc2dc\uba74 \ub0b4\ub2f4\uc790\uc640 \uc0c1\ub2f4\uc0ac\ub294 \ubcf4\ud5d8 \uc815\ubcf4 \ubc0f \ubcf4\ud5d8\uc801\uc6a9 \ubc94\uc704\uc640 \ube44\uc6a9 \ub4f1\uc744 \uc0c1\uc758\ud558\uc5ec \uacb0\uc815\ud55c \ud6c4 \uc0c1\ub2f4\uc744 \uc9c4\ud589\ud558\uac8c \ub429\ub2c8\ub2e4.<\/p>\n<p><strong>\ubcf4\ud5d8\uc774 \uc5c6\ub294 \uacbd\uc6b0<\/strong>: \uc0c1\ub2f4\ube44\uc6a9\uc744 \ubcf4\ud5d8\uc73c\ub85c \ucee4\ubc84\ud560 \uc218 \uc5c6\ub294 \uacbd\uc6b0\ub294 \ub0b4\ub2f4\uc790\uac00 \uc0c1\ub2f4\ube44\uc6a9\uc744 \ubd80\ub2f4\ud558\uc154\uc57c \ud569\ub2c8\ub2e4. \ud611\ub825\uc0c1\ub2f4\uc0ac\ub2d8\uaed8\uc11c \uc800\ub834\ud55c \ube44\uc6a9(\ud68c\ub2f9 80\ubd88)\uc73c\ub85c \uc0c1\ub2f4\uc744 \uc81c\uacf5\ud574 \uc8fc\uc2dc\uba70, \uacbd\uc81c\uc801\uc778 \ud615\ud3b8\ub54c\ubb38\uc5d0 \uc0c1\ub2f4\ubc1b\uc744 \uc6a9\uae30\ub97c \ub0b4\uc9c0 \ubabb\ud558\ub294 \ubd84\ub4e4\uc744 \uc704\ud574 \ub7ec\ube0c \ud1a0\ub860\ud1a0\uc5d0\uc11c \uc0c1\ub2f4 \ube44\uc6a9\uc758 \uc77c\ubd80\ubd84\uc744 \uc9c0\uc6d0\ud574 \ub4dc\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ubb38\uc758\uc2dc \ub0b4\ub2f4\uc790\ub294 \uc0ac\ubb34\uac04\uc0ac\uc640 \ubd80\ub2f4\uac00\ub2a5\ud55c \uc0c1\ub2f4\ube44\uc6a9\uc744 \ud611\uc758\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><strong>\uc811\uc218<\/strong>: \ub7ec\ube0c\ud1a0\ub860\ud1a0 \ud648\ud398\uc774\uc9c0\uc5d0\uc11c ``\ubb38\uc758\ud558\uae30&gt;\uc815\uc2e0\uac74\uac15\uc0c1\ub2f4\ubb38\uc758`` \ub85c \uc2e0\uccad\ud558\uc2dc\uba74 \ud611\ub825 \uc0c1\ub2f4\uc0ac\uc5d0\uac8c \uc5f0\uacb0\ud574 \ub4dc\ub9bd\ub2c8\ub2e4. \ubcf4\ud5d8\uc774 \uc5c6\ub294 \uacbd\uc6b0 \uc0c1\ub2f4\uc9c0\uc6d0\ube44\ub294 \ubb38\uc758 \uc811\uc218\uc2dc \uc0ac\ubb34\uac04\uc0ac\uc640 \ud611\uc758\ud558\uc5ec \uacb0\uc815\ud558\uace0, \uacb0\uc815\ub41c \uc9c0\uc6d0\ube44\ub294 \ub7ec\ube0c \ud1a0\ub860\ud1a0\uac00 \uc0c1\ub2f4\uc0ac\uc5d0\uac8c \uc804\ub2ec\ud574\ub4dc\ub9ac\uace0 \ubcf8\uc778 \ubd80\ub2f4\uae08\uc740 \ub0b4\ub2f4\uc790\uac00 \uc9c1\uc811 \uc0c1\ub2f4\uc0ac\uc5d0\uac8c \uc9c0\ubd88\ud569\ub2c8\ub2e4. \uc0c1\ub2f4\uc758 \ud68c\uc218\uc640 \ub0b4\uc6a9\uc5d0 \ub530\ub77c \ubcf8\uc778\uc774 \ucd94\uac00\ub85c \ubd80\ub2f4\ud558\uc154\uc57c \ud558\ub294 \ubd80\ubd84\uc774 \uc0dd\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p><strong>\ucc38\uace0:<\/strong> \uc815\ubd80 \ub610\ub294 \uae30\uad00\uc5d0 \uc0c1 \uc0c1\ub2f4\uacb0\uacfc(\uc0c1\ub2f4\ub178\ud2b8, \uc18c\uacac\uc11c \ub4f1)\ub97c \uc81c\ucd9c\ud560 \ubaa9\uc801\uc73c\ub85c \uc0c1\ub2f4\uc744 \ubc1b\uc744 \uacbd\uc6b0, \ubbf8\ub9ac \uc0c1\ub2f4\uc0ac\uc5d0\uac8c \ud544\uc694\ud55c \uc11c\ub958\ub97c \ubc1c\uae09\ud574 \uc904 \uc218 \uc788\ub294 \ubb38\uc758\ud558\uc154\uc57c \ud569\ub2c8\ub2e4. \uc0c1\ub2f4\uc0ac\uac00 \ub3d9\uc758\ud560 \uacbd\uc6b0 \uc11c\ub958\ub97c \ubc1c\uae09\ud558\ub418 \ubc1c\uae09 \ube44\uc6a9\uc740 \ub0b4\ub2f4\uc790\uac00 \ubcc4\ub3c4\ub85c \ubd80\ub2f4\ud558\uc154\uc57c \ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\ubcf4\ud5d8\uc801\uc6a9\uc5ec\ubd80 \ud655\uc778\ud558\uae30<\/strong><br \/>\n<strong>Blue Cross<\/strong>: <a>https:\/\/members.medaviebc.ca\/en\/login<\/a><br \/>\n<strong>Sun Life<\/strong>: <a>https:\/\/www.sunnet.sunlife.com\/signin\/mysunlife\/home.wca?<\/a><br \/>\n<strong>Manulife Financial<\/strong>: <a>https:\/\/www.manulife.ca\/personal\/sign-in.html<\/a><br \/>\n<strong>Desjardins Insurance<\/strong>: <a>https:\/\/www.desjardins.com\/on\/en.html<\/a><\/p>\n<p>\u203b\ub300\ud559\uad50 \ud559\uc0dd\ubcf4\ud5d8\uc801\uc6a9 \uc5ec\ubd80\ub97c \ud655\uc778\ud558\uc2dc\ub824\uba74 \ubcf8\uc778 \ud559\uad50 \ud648\ud398\uc774\uc9c0\uc5d0\uc11c student wellness centre\/counselling centre\ub97c \ubc29\ubb38\ud558\uc5ec \ud655\uc778\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p><a class=\"grop-btn grop-btn_overly grop-grop-oimtrm_btn\" href=\"\/contact\/?menu=contact-3\" ><span>\uc815\uc2e0\uac74\uac15\uc0c1\ub2f4 \ubb38\uc758\ud558\uae30<\/span><\/a><\/div><\/div>[vc_raw_js][\/vc_raw_js][\/vc_column][\/vc_row][vc_row overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1586887724208{padding-top: 20px !important;padding-bottom: 20px !important;}&#8221;][vc_column][vc_raw_html]JTNDZGl2JTIwaWQlM0QlMjJzZWN0aW9uXzQlMjIlMjBzdHlsZSUzRCUyMnBvc2l0aW9uJTNBJTIwYWJzb2x1dGUlM0IlMjB0b3AlM0ElMjAtMTAwcHglM0IlMjIlM0UlMEElMjZuYnNwJTNCJTBBJTNDJTJGZGl2JTNF[\/vc_raw_html]<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\"\n           data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"https:\/\/lovetoronto.org\/wp-content\/uploads\/2026\/01\/800_Senior-Service-3.jpg\" alt=\"\" ><h5 class=\"text-center  grop-oimt_cption\"><\/h5><\/div><\/div><\/div><div class=\"grop-fix  grop-oimt_txt\"><h3>\uc2dc\ub2c8\uc5b4\ubcf5\uc9c0 \uc11c\ube44\uc2a4<\/h3><p class=\"grop-oimt_semi\">\ub7ec\ube0c\ud1a0\ub860\ud1a0 \uc2dc\ub2c8\uc5b4 \ubcf5\uc9c0 \uc11c\ube44\uc2a4\ub294 \uc0ac\ud68c\uc801 \uace0\ub9bd\uacfc \uc678\ub85c\uc6c0\uc744 \uacbd\ud5d8\ud558\ub294 \uc5b4\ub974\uc2e0\ub4e4\uc774 \uc9c0\uc5ed\uc0ac\ud68c \uc548\uc5d0\uc11c \uac74\uac15\ud558\uace0 \uc874\uc5c4\ud55c \uc0b6\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc6d0\ud558\ub294 \ucc3e\uc544\uac00\ub294 \ubb34\ub8cc \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4. \ubc29\ubb38, \uc804\ud654, \uadf8\ub8f9 \ud504\ub85c\uadf8\ub7a8\uc744 \ud1b5\ud574 \uc815\uc11c\uc801 \uc548\uc815\uacfc \uc0ac\ud68c\uc801 \uc5f0\uacb0\uc744 \uac15\ud654\ud558\uace0, \ud544\uc694\ud55c \uc9c0\uc5ed\uc0ac\ud68c \ubcf5\uc9c0 \uc790\uc6d0\uacfc \uc5f0\uacc4\ud558\uc5ec \uc5b4\ub974\uc2e0\ub4e4\uc774 \ubcf4\ub2e4 \uc548\uc804\ud558\uace0 \ud65c\uae30\ucc2c \uc77c\uc0c1\uc744 \uc774\uc5b4\uac08 \uc218 \uc788\ub3c4\ub85d \ub3d5\uc2b5\ub2c8\ub2e4.<\/p><p>\uc8fc\uc694 \ud504\ub85c\uadf8\ub7a8:<\/p>\n<p><strong>\ubc29\ubb38 \uce5c\uad6c (Friendly Visiting)<\/strong>: \uad50\uc721\uc744 \uc774\uc218\ud55c \uc790\uc6d0\ubd09\uc0ac\uc790\uac00 \uc815\uae30\uc801\uc73c\ub85c \uac00\uc815\uc744 \ubc29\ubb38\ud558\uc5ec \ub9d0\ubc97\uc774 \ub418\uc5b4 \ub4dc\ub9bd\ub2c8\ub2e4. \ub530\ub73b\ud55c \ub300\ud654\uc640 \uad50\ub958\ub97c \ud1b5\ud574 \uc815\uc11c\uc801 \uc9c0\uc9c0\ub97c \uc81c\uacf5\ud558\uace0, \uc548\ubd80 \ud655\uc778\uacfc \uc0dd\ud65c \ubcc0\ud654\ub97c \uc0b4\ud53c\uba70 \ud544\uc694\ud55c \uacbd\uc6b0 \uc9c0\uc5ed\uc0ac\ud68c \ubcf5\uc9c0 \ubc0f \uc9c0\uc6d0 \uc11c\ube44\uc2a4\uc640 \uc5f0\uacc4\ud558\ub294 \uc5ed\ud560\uc744 \uc218\ud589\ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\uc804\ud654\uce5c\uad6c (Phone Reassurance)<\/strong>: \uc678\ucd9c\uc774 \uc5b4\ub835\uac70\ub098 \uc0ac\ud68c\uc801 \uad50\ub958\uac00 \uc81c\ud55c\ub41c \uc5b4\ub974\uc2e0\ub4e4\uc5d0\uac8c \uc815\uae30\uc801\uc778 \uc548\ubd80 \uc804\ud654\ub97c \ub4dc\ub9bd\ub2c8\ub2e4. \uc9c0\uc18d\uc801\uc778 \uc18c\ud1b5\uacfc \uc815\uc11c\uc801 \uc9c0\uc9c0\ub97c \ud1b5\ud574 \uc678\ub85c\uc6c0\uacfc \uc0ac\ud68c\uc801 \uace0\ub9bd\uc744 \uc608\ubc29\ud558\uace0, \ub3c4\uc6c0\uc774 \ud544\uc694\ud55c \uc0c1\ud669\uc744 \uc870\uae30\uc5d0 \ud655\uc778\ud558\uc5ec \uc801\uc808\ud55c \uc9c0\uc6d0\uc73c\ub85c \uc5f0\uacb0\ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\uc2dc\ub2c8\uc5b4 \ud074\ub798\uc2a4 (Senior Class)<\/strong>: \uc5b4\ub974\uc2e0\ub4e4\uc774 \ud568\uaed8 \ubc30\uc6b0\uace0 \uad50\ub958\ud558\ub294 \ubb34\ub8cc \uadf8\ub8f9 \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4. \ubbf8\uc220, \uc74c\uc545, \uc758\uc790 \uc6b4\ub3d9, \uc778\uc9c0\ud65c\ub3d9 \ub4f1 \ub2e4\uc591\ud55c \uce58\ub9e4 \uc608\ubc29 \ubc0f \uac74\uac15\uc99d\uc9c4 \ud504\ub85c\uadf8\ub7a8\uc744 \uc6b4\uc601\ud558\uba70, \uc0ac\ud68c\uc801 \uad00\uacc4 \ud615\uc131\uacfc \uc18c\uc18d\uac10\uc744 \ub192\uc5ec \uc77c\uc0c1\uc758 \ud65c\ub825\uc744 \ud68c\ubcf5\ud560 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc6d0\ud569\ub2c8\ub2e4.<\/p>\n<p><strong>\ud55c\uc778 Meals on Wheels \uc11c\ube44\uc2a4: TheraMeals<\/strong><br \/>\n\ub7ec\ube0c\ud1a0\ub860\ud1a0\ub294 \uac74\uac15\ud558\uace0 \uade0\ud615 \uc7a1\ud78c \uc2dd\uc0ac \uc9c0\uc6d0\uc774 \ud544\uc694\ud55c \ud55c\uc778 \uc2dc\ub2c8\uc5b4\ubd84\ub4e4\uc744 \uc704\ud574 TheraMeals \uc5d0\uc11c \uc6b4\uc601\ud558\ub294 GTA \uc9c0\uc5ed \ud55c\uc778 Meals on Wheels \uc11c\ube44\uc2a4 \uc548\ub0b4 \ubc0f \uc2e0\uccad \uc9c0\uc6d0\uc744 \uc81c\uacf5\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\ubcf8 \uc11c\ube44\uc2a4\ub294 TheraMeals \uc5d0\uc11c \uc9c1\uc811 \uc6b4\uc601\u2022 \uc81c\uacf5\ud558\uba70, Love Toronto\ub294 \uc815\ubcf4 \uc81c\uacf5 \ubc0f \uc2e0\uccad \uc9c0\uc6d0\uc744 \ub3d5\uace0\uc788\uc2b5\ub2c8\ub2e4. \uc11c\ube44\uc2a4\uc5d0 \ub300\ud55c \uc790\uc138\ud55c \ub0b4\uc6a9\uacfc \uc2e0\uccad \ubc29\ubc95\uc740 <a>https:\/\/www.therameals.ca\/contact<\/a>\ub97c \ud1b5\ud574 \ud655\uc778\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p><a class=\"grop-btn grop-btn_overly grop-grop-oimtrm_btn\" href=\"\/contact\/?menu=contact-7\" ><span>\uc2dc\ub2c8\uc5b4 \ubcf5\uc9c0 \uc11c\ube44\uc2a4 \ubb38\uc758\ud558\uae30<\/span><\/a><\/div><\/div>[\/vc_column][\/vc_row][vc_row overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1784555042261{padding-top: 20px !important;padding-bottom: 20px !important;}&#8221;][vc_column][vc_raw_html]JTNDZGl2JTIwaWQlM0QlMjJzZWN0aW9uXzUlMjIlMjBzdHlsZSUzRCUyMnBvc2l0aW9uJTNBJTIwYWJzb2x1dGUlM0IlMjB0b3AlM0ElMjAtMTAwcHglM0IlMjIlM0UlMEElMjZuYnNwJTNCJTBBJTNDJTJGZGl2JTNF[\/vc_raw_html]<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\"\n           data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"https:\/\/lovetoronto.org\/wp-content\/uploads\/2026\/06\/Funded-in-part-by_Canada_WordmarkNHSP-EN-8.png\" alt=\"\" ><h5 class=\"text-center  grop-oimt_cption\"><\/h5><\/div><\/div><\/div><div class=\"grop-fix  grop-oimt_txt\"><h3>New Horizons for Seniors Program (NHSP)<\/h3><p>\ub7ec\ube0c \ud1a0\ub860\ud1a0\uc758 \uc2dc\ub2c8\uc5b4\ubcf5\uc9c0\uc11c\ube44\uc2a4 \uc0ac\uc5c5\uc740 \uce90\ub098\ub2e4 \uc815\ubd80 NHSP(New Horizons for Seniors Program)\uc758 \uc7ac\uc815 \uc9c0\uc6d0\uc744 \ubc1b\uc544 \uc6b4\uc601\ub429\ub2c8\ub2e4.<\/p><\/div><\/div>[\/vc_column][\/vc_row][vc_row overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1586887886085{padding-top: 20px !important;padding-bottom: 20px !important;}&#8221;][vc_column][vc_raw_html]JTNDZGl2JTIwaWQlM0QlMjJzZWN0aW9uXzMlMjIlMjBzdHlsZSUzRCUyMnBvc2l0aW9uJTNBJTIwYWJzb2x1dGUlM0IlMjB0b3AlM0ElMjAtMTAwcHglM0IlMjIlM0UlMEElMjZuYnNwJTNCJTBBJTNDJTJGZGl2JTNF[\/vc_raw_html]<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\"\n           data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"https:\/\/lovetoronto.org\/wp-content\/uploads\/2020\/03\/card_4.jpg\" alt=\"\" ><h5 class=\"text-center  grop-oimt_cption\"><\/h5><\/div><\/div><\/div><div class=\"grop-fix  grop-oimt_txt\"><h3>ADULT DAY PROGRAM<\/h3><p class=\"grop-oimt_semi\">\uc544\ub9ac\ub791 \uc2dc\ub2c8\uc5b4\uc13c\ud130\uc640 CHATS\uac00 \ud611\ub825\ud558\uc5ec \ud558\ub8e8\uc5d0 6\uc2dc\uac04 \uc815\ub3c4\uc529 \uc77c\uc8fc\uc77c\uc5d0 \uc774\ud2c0 \ubc00\uc54c\uad50\ud68c \uac74\ubb3c\uc5d0\uc11c \uc6b4\uc601\ud558\uace0 \uc788\uc785\ub2c8\ub2e4. \ub9e4\uc8fc \ud654\uc694\uc77c\/\uae08\uc694\uc77c \uc624\uc804 9\uc2dc-\uc624\ud6c43\uc2dc\uc5d0 \uc6b4\uc601\ub418\uace0 \uc788\uc73c\uba70, \uc57d25\uba85 \uc815\ub3c4\uc758 \uc5b4\ub974\uc2e0\ub4e4\uc774 \ud504\ub85c\uadf8\ub7a8\uc744 \uc774\uc6a9\ud558\uace0 \uacc4\uc2ed\ub2c8\ub2e4. \uc774 \ud504\ub85c\uadf8\ub7a8\uc744 \ud1b5\ud574\uc11c \uc9d1\uc5d0\uc11c \ubab8\uc774 \ubd88\ud3b8\ud558\uc2e0 \uc5b4\ub974\uc2e0\ub4e4\uc744 \ub3cc\ubcf4\ub294 \uac00\uc871\ub4e4\uc5d0\uac8c\ub294 \ud734\uc2dd\uc758 \uc2dc\uac04\uc744, \ubb34\ub8cc\ud55c \uc2dc\uac04\uc744 \ubcf4\ub0b4\uc2dc\ub294 \uc5b4\ub974\uc2e0\ub4e4\uc5d0\uac8c\ub294 \ub2e4\uc591\ud55c \ud65c\ub3d9\uacfc \uce5c\uad50\uc758 \uc2dc\uac04\uc744 \uc81c\uacf5\ud574 \ub4dc\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.<\/p><p>\uc774 \ud504\ub85c\uadf8\ub7a8\uc5d0 \ucc38\uac00\ub97c \ud76c\ub9dd\ud558\uc2dc\ub294 \ubd84\uc740 \uac00\uc815\uc758 \uc0ac\ubb34\uc2e4\uc5d0 \ube44\uce58\ub418\uc5b4 \uc788\ub294 \uc2e0\uccad\uc11c\ub97c \uc791\uc131\ud558\uc2dc\uace0 \uac00\uc815\uc758\ub97c \ud1b5\ud574\uc11c ADP\uc5d0 \ubcf4\ub0b4\uc2dc\uba74 \ub429\ub2c8\ub2e4. \uce58\ub9e4\ucd08\uae30 \uc99d\uc0c1 \ub610\ub294 \ubab8\uc774 \ubd88\ud3b8\ud558\uc2e0 \uc815\ub3c4\uc5d0 \ub530\ub77c \uc6b0\uc120 \uc21c\uc704\uac00 \uc815\ud574\uc9c0\uace0, \ub300\uae30\uc790\uac00 \uc788\uc5b4\uc11c \uc2e0\uccad \ud6c4 \uc7a5\uae30\uac04 \uae30\ub2e4\ub9b4 \uc218\ub3c4 \uc788\uc74c\uc744 \uc591\ud574\ud574 \uc8fc\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.<\/p>\n<p><b>NYSC ADP<\/b><\/p>\n<p>North York Seniors Centre(NYSC)\uc640 Love Toronto Korean-Canadian Community Services\uc758 \ud611\ub825\uc73c\ub85c \uc6b4\uc601\ub418\ub294 \ud55c\uc778 Adult Day Program\uc740 2026\ub144 9\uc6d4 30\uc77c\ubd80\ud130 \uc2dc\uc791\ub429\ub2c8\ub2e4. \ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740 \ub9e4\uc8fc \uc218\uc694\uc77c \uc624\uc804 9\uc2dc 30\ubd84\ubd80\ud130 \uc624\ud6c4 3\uc2dc\uae4c\uc9c0(\ucd1d 5\uc2dc\uac04 30\ubd84) NYSC\uc5d0\uc11c \uc6b4\uc601\ub418\uba70, \uc57d 10\uba85\uc758 \ud55c\uc778 \uc2dc\ub2c8\uc5b4\ubd84\ub4e4\uc744 \ub300\uc0c1\uc73c\ub85c \uc9c4\ud589\ub429\ub2c8\ub2e4.<\/p>\n<p>\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740 \uc77c\uc0c1\uc0dd\ud65c \uc9c0\uc6d0\uc774 \ud544\uc694\ud55c \uc5b4\ub974\uc2e0\ub4e4\uc5d0\uac8c \ub2e4\uc591\ud55c \ud65c\ub3d9\uacfc \uc0ac\ud68c\uc801 \uad50\ub958\uc758 \uae30\ud68c\ub97c \uc81c\uacf5\ud558\uace0, \uac00\uc815\uc5d0\uc11c \uc5b4\ub974\uc2e0\uc744 \ub3cc\ubcf4\ub294 \uac00\uc871\ub4e4\uc5d0\uac8c\ub294 \ub3cc\ubd04 \ubd80\ub2f4\uc744 \ub35c\uace0 \ud734\uc2dd\ud560 \uc218 \uc788\ub294 \uc2dc\uac04\uc744 \uc81c\uacf5\ud558\ub294 \uac83\uc744 \ubaa9\uc801\uc73c\ub85c \ud569\ub2c8\ub2e4.<\/p>\n<p>\u203b\ud504\ub85c\uadf8\ub7a8 \ucc38\uc5ec\ub97c \uc704\ud574\uc11c\ub294 \uc8fc\uce58\uc758(Family Physician) \ub610\ub294 \uc2b9\uc778\ub41c \uc758\ub8cc \uc11c\ube44\uc2a4 \uc81c\uacf5\uc790\uc758 Referral Letter(\ucd94\ucc9c\uc11c)\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ucc38\uc5ec \uac00\ub2a5 \uc5ec\ubd80\ub294 NYSC\uc758 \ub4f1\ub85d \uc0c1\ub2f4(Intake Assessment) \ubc0f \ud3c9\uac00 \uc808\ucc28\ub97c \ud1b5\ud574 \ucd5c\uc885 \uacb0\uc815\ub418\uba70, \uc5b4\ub974\uc2e0\uc758 \uac74\uac15 \uc0c1\ud0dc, \uc9c0\uc6d0 \ud544\uc694\ub3c4 \ubc0f \ud504\ub85c\uadf8\ub7a8 \uc815\uc6d0\uc5d0 \ub530\ub77c \uc6b0\uc120\uc21c\uc704\uac00 \uc815\ud574\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc815\uc6d0\uc774 \uc81c\ud55c\ub418\uc5b4 \uc788\uc5b4 \ub300\uae30\uc790\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.<\/p>\n<p>\uc6b4\uc601 \uc7a5\uc18c: <b>North York Seniors Centre 21 Hendon Avenue Toronto, ON M2M 4G8<\/b><\/p><a class=\"grop-btn grop-btn_overly grop-grop-oimtrm_btn\" href=\"\/contact\/?menu=contact-4\" ><span>ADULT DAY PROGRAM \ubb38\uc758\ud558\uae30<\/span><\/a><\/div><\/div>[\/vc_column][\/vc_row][vc_row full_width=&#8221;stretch_row&#8221; overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1695996038774{margin-top: 40px !important;padding-top: 20px !important;padding-bottom: 20px !important;background: #f0c84c url(http:\/\/victorthemes.com\/themes\/groppe\/wp-content\/uploads\/2017\/01\/callout-bg-pattern.png?id=702) !important;}&#8221;][vc_column css=&#8221;.vc_custom_1695996029793{padding-top: 20px !important;padding-bottom: 20px !important;}&#8221;]<div class=\"grop-callout_area  grop-parlx-6ad1906b0d88f\"><div class=\"grop-vertical_middle  grop-fix grop-callout_container   vc_custom_1695996170948\"><div class=\"grop-cta-cnt style-two\" ><div class=\"text-left text-uppercase  grop-hm3callou