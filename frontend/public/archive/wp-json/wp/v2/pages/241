_1585171676249{padding-top: 0px !important;padding-right: 0px !important;padding-bottom: 0px !important;padding-left: 0px !important;}&#8221;]<div class=\"grop-section_text   grop-heading-6ad1906853e21   vc_custom_1786119229696 text-center\"><h3 class=\"text-uppercase grop-sctn_title_fntSz-30   grop-heading-6ad1906853e21  text-center\">\ub7ec\ube0c \ud1a0\ub860\ud1a0\uc758 \ube44\uc804<\/h3><p>\u201c \uce90\ub098\ub2e4\uc5d0\uc11c \ud55c\uc778\uc73c\ub85c \ud589\ubcf5\ud55c \uc0dd\ud65c\uc744 \uc601\uc704\ud558\ub294\ub370 \uac78\ub9bc\ub3cc\uc774 \ub418\ub294 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub294\ub370 \uc2e4\uc9c8\uc801\uc778 \ub3c4\uc6c0\uc744 \uc81c\uacf5\ud55c\ub2e4. \ub7ec\ube0c \ud1a0\ub860\ud1a0\ub294 \ud1a0\ub860\ud1a0 \uc9c0\uc5ed \ud55c\uc778\uc0ac\ud68c\ub97c \uc704\ud55c \ub124\ud2b8\uc6cc\ud06c \ud5c8\ube0c\ub85c\uc11c, \ub3c4\uc6c0\uc774 \ud544\uc694\ud55c \uc9c0\uc5ed\uc0ac\ud68c \uad6c\uc131\uc6d0\ub4e4\uc744 \uc0ac\ub791\uacfc \uc874\uc911, \uadf8\ub9ac\uace0 \uc874\uc5c4\uc131\uc744 \ubc14\ud0d5\uc73c\ub85c \uc12c\uae30\uae30 \uc704\ud574 \ub178\ub825\ud55c\ub2e4.``<\/p><\/div><div class=\"grop-section_text   grop-heading-6ad1906853e39   vc_custom_1786119272604 text-center\"><h2 class=\"text-uppercase grop-sctn_title_fntSz-30   grop-heading-6ad1906853e39  text-center\">\ub7ec\ube0c \ud1a0\ub860\ud1a0\uc758 \uc0ac\uba85<\/h2><p>\u201c \ub7ec\ube0c \ud1a0\ub860\ud1a0\ub294 \uce90\ub098\ub2e4\uc5d0 \uac70\uc8fc\ud558\ub294 \ud55c\uc778\ub4e4\uc774 \ubb38\ud654\uc801, \uc5b8\uc5b4\uc801, \uc0ac\ud68c\uc801 \ub610\ub294 \uae30\ud0c0 \uc5ec\ub7ec \uc7a5\ubcbd\uc73c\ub85c \uc778\ud574 \uacaa\uc744 \uc218 \uc788\ub294 \uc5b4\ub824\uc6c0\uc744 \uadf9\ubcf5\ud560 \uc218 \uc788\ub3c4\ub85d \uc2e4\uc9c8\uc801\uc778 \ub3c4\uc6c0\uacfc \ud544\uc694\ud55c \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\ub294 \uac83\uc744 \uc0ac\uba85\uc73c\ub85c \ud55c\ub2e4.\u201d<\/p><\/div>[\/vc_column][\/vc_row][vc_row gap=&#8221;20&#8243; overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1586887210760{margin-top: 20px !important;margin-bottom: 20px !important;padding-top: 0px !important;padding-right: 0px !important;padding-left: 0px !important;}&#8221;][vc_column css=&#8221;.vc_custom_1586887162266{padding-top: 0px !important;}&#8221; offset=&#8221;vc_col-lg-6 vc_col-md-6&#8243;][vc_column_text el_class=&#8221;grop-fix grop-about_txt&#8221;]<\/p>\n<h3>\uc804\ub7b5<\/h3>\n<ul>\n<li>\ubc95\ub960\uc801 \ubb38\uc81c\uc5d0 \ub300\ud55c \uc62c\ubc14\ub978 \uc815\ubcf4\uc640 \uac00\uc774\ub4dc\ub77c\uc778\uc744 \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \ubb38\uc81c\uc758 \ud574\uacb0 \ubc29\ubc95\uc744 \ucc3e\ub294\ub370 \ub3c4\uc6c0\uc744 \uc900\ub2e4.<\/li>\n<li>\ud55c\uad6d\uc5b4\ub85c \uc815\uc2e0\uac74\uac15\uc0c1\ub2f4 \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \ud55c\uc778\uc758 \uc815\uc2e0\uac74\uac15\ubb38\uc81c\ub97c \uc608\ubc29, \uc810\uac80, \uce58\ub8cc\ud558\ub294\ub370 \ub3c4\uc6c0\uc744 \uc900\ub2e4.<\/li>\n<li>\ub178\uc778\ubcf5\uc9c0 \uad00\ub828 \ub2e8\uccb4\uc640 \ud611\ub825\ud558\uc5ec \ud55c\uc778\ub4e4\uc774 \uc774\uc6a9\ud560 \uc218 \uc788\ub294 \ub178\uc778\ubcf5\uc9c0 \uc2dc\uc124 \ubc0f \ud504\ub85c\uadf8\ub7a8\uc744 \uad6c\ucd95\ud558\ub294\ub370 \ub3c4\uc6c0\uc744 \uc81c\uacf5\ud55c\ub2e4.<\/li>\n<li>\ub2e8\uae30 \ud589\uc0ac\ub098 \uc9c0\uc18d\uc801\uc778 \uc0ac\ubb34\uacf5\uac04\uc774 \ud544\uc694\ud55c \ub2e8\uccb4 \ubc0f \uae30\uad00\uc744 \uc704\ud574 \ub7ec\ube0c \ud1a0\ub860\ud1a0\uc758 \uc0ac\ubb34\uacf5\uac04\uc744 \ubb34\ub8cc \ub610\ub294 \ucd5c\uc18c\ud55c\uc758 \ube44\uc6a9\uc73c\ub85c \uc81c\uacf5\ud55c\ub2e4.<\/li>\n<\/ul>\n<p>[\/vc_column_text][\/vc_column][vc_column offset=&#8221;vc_col-lg-6 vc_col-md-6&#8243; css=&#8221;.vc_custom_1586887154789{padding-top: 0px !important;}&#8221;][vc_column_text el_class=&#8221;grop-fix grop-about_txt&#8221;]<\/p>\n<h3>\ud575\uc2ec \uac00\uce58<\/h3>\n<ul>\n<li>\uc874\uc911: \uac1c\uc778\uc758 \uac00\uce58\uc640 \uc874\uc5c4\uc131, \uac01 \uae30\uad00\uc758 \uac00\uce58\uad00\uc744 \uc778\uc815\ud558\uace0 \uc874\uc911\ud55c\ub2e4.<\/li>\n<li>\uc131\uc2e4: \ubaa8\ub4e0 \uc5c5\ubb34\uc5d0 \uc788\uc5b4\uc11c \ud3c9\ub4f1, \uc131\uc2e4, \uc815\uc9c1, \ucc45\uc784\uc788\ub294 \uc790\uc138\ub85c \uc784\ud55c\ub2e4.<\/li>\n<li>\ud611\ub825: \uc5c5\ubb34\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc218\ud589\ud558\uae30\uc704\ud558\uc5ec\ubaa8\ub4e0 \ub0b4\uc678\ubd80 \uae30\uad00\uacfc \uc0c1\ud638\ud611\ub825\ud55c\ub2e4.<\/li>\n<li>\ucc3d\uc758: \uc2dc\ub300\uc5d0 \ub530\ub77c \ubcc0\ud654\ud558\ub294 \ud55c\uc778 \uc0ac\ud68c\uc758 \uc694\uad6c\ub97c \ud310\ub2e8\ud558\uace0 \uadf8\uc5d0 \ub9de\ub294 \uc11c\ube44\uc2a4 \ub97c \uac1c\ubc1c, \uc81c\uacf5\ud55c\ub2e4.<\/li>\n<\/ul>\n<p>[\/vc_column_text][\/vc_column][\/vc_row][vc_row full_width=&#8221;stretch_row_content_no_spaces&#8221; overlay_dotted=&#8221;&#8221; css=&#8221;.vc_custom_1584737468633{background-image: url(https:\/\/lovetoronto.org\/wp-content\/uploads\/2020\/03\/0.banner_donation.jpg?id=2698) !important;background-position: center !important;background-repeat: no-repeat !important;background-size: cover !important;}&#8221;][vc_column css=&#8221;.vc_custom_1584644856121{padding-top: 0px !important;padding-bottom: 0px !important;background-color: rgba(10,10,10,0.4) !important;*background-color: rgb(10,10,10) !important;}&#8221;]<div class=\"grop-callout_area  grop-parlx-6ad1906853e4b\"><div class=\"grop-vertical_middle  grop-fix grop-callout_container  \"><p><span style=\"font-size: 46px; line-height: 62px; color: #ffffff; font-family: 'BMJUA';\">\ub7ec\ube0c \ud1a0\ub860\ud1a0 \ud6c4\uc6d0 \uc548\ub0b4<\/span><\/p>\n<p style=\"font-size: 16px;\"><span style=\"color: #c3c3c3;\">\ub7ec\ube0c \ud1a0\ub860\ud1a0\ub294 \ubc95\ub960, \uc815\uc2e0 \uac74\uac15 \uc0c1\ub2f4 \ub4f1 \uac01 \ubd84\uc57c\uc758 \uc804\ubb38\uac00\ub4e4\uc758 \uc790\uc6d0\ubd09\uc0ac \ubc0f \ud611\ub825\uc73c\ub85c \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\uace0 \uc788\uc