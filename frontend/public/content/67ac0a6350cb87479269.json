item%2F%ED%98%BC%EC%9D%B8%EA%B3%BC-%EC%82%AC%EC%8B%A4%ED%98%BC-%EA%B4%80%EA%B3%84%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2023/07/%ED%98%BC%EC%9D%B8%EA%B3%BC-%EC%82%AC%EC%8B%A4%ED%98%BC-%EA%B4%80%EA%B3%84.jpg\" alt=\"혼인과 사실혼 관계\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%ED%98%BC%EC%9D%B8%EA%B3%BC-%EC%82%AC%EC%8B%A4%ED%98%BC-%EA%B4%80%EA%B3%84%2Findex.html\">혼인과 사실혼 관계</a>\n                  </h4>\n                  <div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://stepstojustice.ca/legal-topic/family-law/marriage-and-common-law-relationships/\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%ED%98%BC%EC%9D%B8%EA%B3%BC-%EC%82%AC%EC%8B%A4%ED%98%BC-%EA%B4%80%EA%B3%84%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n                        <div class=\"grop-filter_single_col  grop-projctfilter_col bpw-col-4  grop-project-6ad19129458bc category-2 \">\n              <div class=\"grop-projct_itm_warp\">\n                <!--project Media box start \\-->\n                <div class=\"grop-projct_media_box\">\n                  <a class=\"grop-cause_media_img\" href=\"#/page?file=lawbook-item%2F%EC%B6%9C%EC%83%9D%EA%B3%BC-%EC%9E%85%EC%96%91%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2023/07/book_family_5ccustodyAccess.jpg\" alt=\"출생과 입양\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EC%B6%9C%EC%83%9D%EA%B3%BC-%EC%9E%85%EC%96%91%2Findex.html\">출생과 입양</a>\n                  </h4>\n                  <p>법원에 가지않고도 배우자와 문제를 해결할 수 있습니다. 당신은 스스로 배우자와 문제에 대해 의논하여 합의점에 도달하거나, 둘다 신뢰할 수 있는 사람의 도움을 받아 합의를 볼 수 도 있습니다. 변호사를 선임하거나 가정법에 전문가인 조정자 또는 중재자를 통하여서 도움을 받을 수 도 있습니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://stepstojustice.ca/legal-topic/family-law/birth-and-adoption/\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EC%B6%9C%EC%83%9D%EA%B3%BC-%EC%9E%85%EC%96%91%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n                        <div class=\"grop-filter_single_col  grop-projctfilter_col bpw-col-4  grop-project-6ad19129458bc category-2 \">\n              <div class=\"grop-projct_itm_warp\">\n                <!--project Media box start \\-->\n                <div class=\"grop-projct_media_box\">\n                  <a class=\"grop-cause_media_img\" href=\"#/page?file=lawbook-item%2F%EC%9D%B4%ED%98%BC%EC%8B%A0%EC%B2%AD%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/book_family_2divorce.jpg\" alt=\"이혼신청\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EC%9D%B4%ED%98%BC%EC%8B%A0%EC%B2%AD%2Findex.html\">이혼신청</a>\n                  </h4>\n                  <p>당신이 법적으로 혼인 관계에 있고, 이 혼인 관계를 끝내고 싶다면, 반드시 법원에 이혼 명령을 신청해야 합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://stepstojustice.ca/questions/family-law/how-do-i-apply-divorce-myself\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3395/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EC%9D%B4%ED%98%BC%EC%8B%A0%EC%B2%AD%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n                        <div class=\"grop-filter_single_col  grop-projctfilter_col bpw-col-4  grop-project-6ad19129458bc category-2 \">\n              <div class=\"grop-projct_itm_warp\">\n                <!--project Media box start \\-->\n                <div class=\"grop-projct_media_box\">\n                  <a class=\"grop-cause_media_img\" href=\"#/page?file=lawbook-item%2F%EC%86%8C%EC%86%A1%ED%95%98%EC%A7%80-%EC%95%8A%EB%8A%94-%EA%B2%BD%EC%9A%B0%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2023/07/%EC%86%8C%EC%86%A1%ED%95%98%EC%A7%80%EC%95%8A%EB%8A%94%EA%B2%BD%EC%9A%B0.jpg\" alt=\"소송하지 않는 경우\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EC%86%8C%EC%86%A1%ED%95%98%EC%A7%80-%EC%95%8A%EB%8A%94-%EA%B2%BD%EC%9A%B0%2Findex.html\">소송하지 않는 경우</a>\n                  </h4>\n                  <p>법원에 가지않고도 배우자와 문제를 해결할 수 있습니다. 당신은 스스로 배우자와 문제에 대해 의논하여 합의점에 도달하거나, 둘다 신뢰할 수 있는 사람의 도움을 받아 합의를 볼 수 도 있습니다. 변호사를 선임하거나 가정법에 전문가인 조정자 또는 중재자를 통하여서 도움을 받을 수 도 있습니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://stepstojustice.ca/legal-topic/family-law/out-of-court-options/\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EC%86%8C%EC%86%A1%ED%95%98%EC%A7%80-%EC%95%8A%EB%8A%94-%EA%B2%BD%EC%9A%B0%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n                        <div class=\"grop-filter_single_col  grop-projctfilter_col bpw-col-4  grop-project-6ad19129458bc category-2 \">\n              <div class=\"grop-projct_itm_warp\">\n                <!--project Media box start \\-->\n                <div class=\"grop-projct_media_box\">\n                  <a class=\"grop-cause_media_img\" href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EC%9E%90%EB%85%80%EC%9D%98-%EC%9D%98%EC%82%AC-%EA%B2%B0%EC%A0%95%EA%B3%BC-%EC%96%91%EC%9C%A1-%EC%8B%9C%EA%B0%84%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/book_family_5ccustodyAccess.jpg\" alt=\"별거와 이혼: 자녀의 의사 결정과 양육 시간\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EC%9E%90%EB%85%80%EC%9D%98-%EC%9D%98%EC%82%AC-%EA%B2%B0%EC%A0%95%EA%B3%BC-%EC%96%91%EC%9C%A1-%EC%8B%9C%EA%B0%84%2Findex.html\">별거와 이혼: 자녀의 의사 결정과 양육 시간</a>\n                  </h4>\n                  <p>부모가 별거하거나 이혼 할 때, 아이들이 살 곳, 자녀가 각 부모와 함께 보낼 시간, 자녀 양육에 대한 주요 결정을 할 사람을 포함하는 육아 계획을 마련해야 합니다. 이 간행물은 다른 양육권 및 접근 약정, 양육 계획을 작성하는 방법, 부모가 동의 할 수 없는 경우 판사와 중재자가 이러한 결정을 내리는 방법에 대해 설명합니다. 이 간행물은 법적 도움을받을 수있는 곳에 대한 자세한 정보와 함께 제공합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/custodyaccess\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3362/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EC%9E%90%EB%85%80%EC%9D%98-%EC%9D%98%EC%82%AC-%EA%B2%B0%EC%A0%95%EA%B3%BC-%EC%96%91%EC%9C%A1-%EC%8B%9C%EA%B0%84%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n                        <div class=\"grop-filter_single_col  grop-projctfilter_col bpw-col-4  grop-project-6ad19129458bc category-2 \">\n              <div class=\"grop-projct_itm_warp\">\n                <!--project Media box start \\-->\n                <div class=\"grop-projct_media_box\">\n                  <a class=\"grop-cause_media_img\" href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EC%9E%90%EB%85%80-%EC%96%91%EC%9C%A1%EB%B9%84%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/book_family_6childSupport.jpg\" alt=\"별거와 이혼: 자녀 양육비\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EC%9E%90%EB%85%80-%EC%96%91%EC%9C%A1%EB%B9%84%2Findex.html\">별거와 이혼: 자녀 양육비</a>\n                  </h4>\n                  <p>부모가 별거하거나 이혼 할 때, 자녀 양육비를 지불하는 방법에 관한 문제가 발생합니다. 이 간행물에는 아동 양육비를 지불 할 법적 책임이 있는 사람과 지불 할 기본 금액 및 자녀의 생활 준비 및 특별 경비와 같은 지원 금액에 영향을 줄 수 있는 기타 요소를 계산하는 방법에 대해 설명되어 있습니다. 이 간행물은 아동 양육비 지불 방법을 설명하고 학부모에 관한 사회 보조 조항을 제공합니다. 법적인 도움을받을 수있는 곳에 대한 자세한 정보로 제공합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/childsupport\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3365/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EC%9E%90%EB%85%80-%EC%96%91%EC%9C%A1%EB%B9%84%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n                        <div class=\"grop-filter_single_col  grop-projctfilter_col bpw-col-4  grop-project-6ad19129458bc category-2 \">\n              <div class=\"grop-projct_itm_warp\">\n                <!--project Media box start \\-->\n                <div class=\"grop-projct_media_box\">\n                  <a class=\"grop-cause_media_img\" href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EB%B0%B0%EC%9A%B0%EC%9E%90-%EB%B6%80%EC%96%91%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/book_family_3spousalSupport.jpg\" alt=\"별거와 이혼: 배우자 부양\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EB%B0%B0%EC%9A%B0%EC%9E%90-%EB%B6%80%EC%96%91%2Findex.html\">별거와 이혼: 배우자 부양</a>\n                  </h4>\n                  <p>이 간행물은 배우자 지원을 지불해야 하는지 여부, 금액 및 기간에 영향을 미치는 요인을 포함하여 이혼 또는 이혼중인 결혼 또는 사실혼 파트너에 대한 배우자 지원을 검토합니다. 또한 사회 복지 사업에 종사하는 배우자에 대한 정보와 지원금 지불 방법을 설명합니다. 법적인 도움을받을 수있는 곳에 대한 자세한 정보로 제공합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/spousalsupport\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3359/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%EB%B0%B0%EC%9A%B0%EC%9E%90-%EB%B6%80%EC%96%91%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n                        <div class=\"grop-filter_single_col  grop-projctfilter_col bpw-col-4  grop-project-6ad19129458bc category-2 \">\n              <div class=\"grop-projct_itm_warp\">\n                <!--project Media box start \\-->\n                <div class=\"grop-projct_media_box\">\n                  <a class=\"grop-cause_media_img\" href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%ED%98%B9%EC%9D%80-%EC%82%AC%EB%B3%84-%EC%9E%AC%EC%82%B0%EB%B6%84%EB%B0%B0-%EC%82%AC%EC%8B%A4%ED%98%BC%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/book_family_4propertydiv.jpg\" alt=\"별거와 이혼 혹은 사별: 재산분배 (사실혼)\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%ED%98%B9%EC%9D%80-%EC%82%AC%EB%B3%84-%EC%9E%AC%EC%82%B0%EB%B6%84%EB%B0%B0-%EC%82%AC%EC%8B%A4%ED%98%BC%2Findex.html\">별거와 이혼 혹은 사별: 재산분배 (사실혼)</a>\n                  </h4>\n                  <p>이 자료는 결혼 한 배우자와의 이혼 시 재산 분할, 가정에 대한 권리와 의무, 배우자 한 명이 사망시 재산 분배에대한 기본 규칙을 설명합니다. 또한 관습법 배우자의 상황을 설명합니다. 부채, CPP 크레디트 분할 및 서면 계약에 대한 책임 섹션이 있습니다. 이 간행물은 법적 도움을받을 수있는 곳에 대한 자세한 정보와 함께 제공합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/propertydiv\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3356/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EB%B3%84%EA%B1%B0%EC%99%80-%EC%9D%B4%ED%98%BC-%ED%98%B9%EC%9D%80-%EC%82%AC%EB%B3%84-%EC%9E%AC%EC%82%B0%EB%B6%84%EB%B0%B0-%EC%82%AC%EC%8B%A4%ED%98%BC%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n            \n          </div>\n          <!-- Project End -->\n\n        </div>\n      </div>\n            <div class=\"text-center grop-posts-pagination-warp\">\n    <nav class=\"navigation pagination\">\n      <div class=\"nav-links\">\n      <span aria-current=\"page\" class=\"page-numbers current\">1</span>\n<a class=\"page-numbers\" href=\"#/page?file=_offline%2Ffetc