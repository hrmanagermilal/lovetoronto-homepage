%90%ED%86%B5%EB%B2%94%EC%A3%84-1.jpg\" alt=\"교통범죄\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EA%B5%90%ED%86%B5%EB%B2%94%EC%A3%84%2Findex.html\">교통범죄</a>\n                  </h4>\n                  <p>이 자료는 캐나다 온타리오주에서 자동차 운전 시 범죄로 간주될 수 있는 사항에 관한 것입니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://stepstojustice.ca/legal-topic/criminal-law/alcohol-and-drug-offences/\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EA%B5%90%ED%86%B5%EB%B2%94%EC%A3%84%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n                        <div class=\"grop-filter_single_col  grop-projctfilter_col bpw-col-4  grop-project-6ad191f857c6d category-6 \">\n              <div class=\"grop-projct_itm_warp\">\n                <!--project Media box start \\-->\n                <div class=\"grop-projct_media_box\">\n                  <a class=\"grop-cause_media_img\" href=\"#/page?file=lawbook-item%2F%EA%B2%BD%EC%B0%B0%EA%B6%8C-%EB%B6%88%EC%8B%AC-%EA%B2%80%EB%AC%B8%2Findex.html\">\n                    <img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/book_criminallaw_1polPower.jpg\" alt=\"경찰권: 불심 검문\" loading=\"lazy\">\n                  </a>\n\n                </div><!--/end-->\n\n                <!--project content text start \\-->\n                <div class=\"grop-projct_content_warp\">\n                  <h4>\n                    <a href=\"#/page?file=lawbook-item%2F%EA%B2%BD%EC%B0%B0%EA%B6%8C-%EB%B6%88%EC%8B%AC-%EA%B2%80%EB%AC%B8%2Findex.html\">경찰권: 불심 검문</a>\n                  </h4>\n                  <p>이 자료는 경찰에 의해 중지, 심문, 수색, 체포 또는 억류 된 사람의 권리를 명시합니다. 경찰이 언제 누군가의 집에 들어가거나 검색 할 수 있는지도 설명합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/polpower\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3339/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div>\n                  <!--  project btn start  \\-->\n                  <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=lawbook-item%2F%EA%B2%BD%EC%B0%B0%EA%B6%8C-%EB%B6%88%EC%8B%AC-%EA%B2%80%EB%AC%B8%2Findex.html\">\n                    <span>자세히 보기</span>\n                  </a><!--/end-->\n                </div>\n              </div>\n            </div>\n\n            \n          </div>\n          <!-- Project End -->\n\n        </div>\n      </div>\n            <div class=\"text-center grop-posts-pagination-warp\">\n    <nav class=\"navigation pagination\">\n      <div class=\"nav-links\">\n      <a class=\"prev page-numbers\" href=\"#/page?file=lawbook-6%2Fpage%2F1%2Findex.html\"><i class=\"fa fa-angle-left\"></i> Prev</a>\n<a class=\"page-numbers\" href=\"#/page?file=lawbook-6%2Fpage%2F1%2Findex.html\">1</a>\n<span aria-current=\"page\" class=\"page-numbers current\">2</span>      </div>\n    </nav>\n  </div>\n    </div>\n\n    </div></div></div></div><div data-vc-full-width=\"true\" data-vc-full-width-init=\"false\" class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1696012794206 vc_row-has-fill\"><div class=\"wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner vc_custom_1696012787338\"><div class=\"wpb_wrapper\"><div class=\"grop-callout_area  grop-parlx-6ad191f858bea\"><div class=\"grop-vertical_middle  grop-fix grop-callout_container   vc_custom_1504683801218\"><div class=\"grop-cta-cnt style-two\"><div class=\"text-left text-uppercase  grop-hm3callout_txt\"><p style=\"font-size: 14px; line-height: 24px;\"><img decoding=\"async\" class=\"size-full wp-image-2748 alignleft\" src=\"./archive/wp-content/uploads/2020/03/ic_law.png\" alt=\"\" width=\"75\" loading=\"lazy\">법률 정보 책자를 통해서 답을 얻지 못하셨거나, 변호사의 자문이 필요하신 경우 “법률상담 문의하기”를 통해서 질문해 주시기 바랍니다. 문의하실 경우 “상호이익 충돌방지”를 위해서 본인과 상대방의 인적사항에 관한 정보를 반드시 적어주시기 바랍니다.</p>\n</div></div><div class=\"grop-float_right grop-callout_btn_warp\"><div class=\"calout-btn\"><a class=\"grop-btn grop-btn_overly grop-callout_btn grop-btn-6ad191f858cd6-%eb%b2%95%eb%a5%a0%ec%83%81%eb%8b%b4-%eb%ac%b8%ec%9d%98%ed%95%98%ea%b8%b0   vc_custom_1604265769712\" href=\"#/page?file=contact.html\"><span>법률상담 문의하기</span></a></div></div></div></div></div></div></div></div><div class=\"vc_row-full-width vc_clearfix\"></div>\n</div>\n\t\t\t</div><!-- Content Area -->\n\t</div>\n\n\t<footer class=\"grop-footer_area\">\n\t\t<!-- Footer Widgets -->\n<div class=\"grop-footer_top_widgets_warp\">\n\t<div class=\"container\">\n\t\t<div class=\"row grop-footer_widgets\">\n\t\t\t<div class=\"col-md-4\"><div class=\"footer-title-2 grop-ftr_sngl_widget vt-text-widget\"><h4 class=\"grop-ftr_widget_title\">러브 토론토</h4><p class=\"grop-txt-block \">Charitable Organization 70955 4893 RR 0001</p>\n<p class=\"grop-txt-block \">#204-5915 Leslie Street, North York, ON M2H 1J8</p>\n<address class=\"grop-ftr_wigt_locn \"><span class=\" grop-footer-adrs-6ad191f8594fc\">Email: <a href=\"mailto:lovetoronto.office@gmail.com\" target=\"_blank\">lovetoronto.office@gmail.com</a></span><span class=\" grop-footer-adrs-6ad191f85950f\">Phone: <a href=\"tel:+16473465688\">+1 647-346-5688</a></span>\n<span class=\" grop-footer-adrs-6ad191f85951b\">Fax: +1 647-794-1151</span></address><div class=\"clear\"></div></div> <!-- end widget --><div class=\" grop-ftr_sngl_widget widget_polylang\"><ul>\n\t<