enu-item-type-post_type menu-item-object-page current-menu-item page_item page-item-3930 current_page_item current-menu-ancestor current-menu-parent current_page_parent current_page_ancestor menu-item-has-children menu-item-4053\"><a href=\"#/page?file=index__p%3D3930.html\" aria-current=\"page\">Services</a>\n<ul class=\"sub-menu\">\n\t<li class=\"menu-item menu-item-type-custom menu-item-object-custom current-menu-item menu-item-5725\"><a href=\"#/page?file=index__p%3D3930.html&amp;anchor=section_1\" aria-current=\"page\">Legal Counsel Referral Service</a></li>\n\t<li class=\"menu-item menu-item-type-custom menu-item-object-custom current-menu-item menu-item-5726\"><a href=\"#/page?file=index__p%3D3930.html&amp;anchor=section_2\" aria-current=\"page\">Psychotherapeutic Counseling Referral Service</a></li>\n\t<li class=\"menu-item menu-item-type-custom menu-item-object-custom current-menu-item menu-item-5728\"><a href=\"#/page?file=index__p%3D3930.html&amp;anchor=section_4\" aria-current=\"page\">Senior Community Services</a></li>\n\t<li class=\"menu-item menu-item-type-custom menu-item-object-custom current-menu-item menu-item-5727\"><a href=\"#/page?file=index__p%3D3930.html&amp;anchor=section_3\" aria-current=\"page\">Adult Day Program (ADP)</a></li>\n</ul>\n</li>\n<li class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-has-children menu-item-4057\"><a href=\"#/page?file=index__p%3D3930.html&amp;anchor=0\">Community</a>\n<ul class=\"sub-menu\">\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4056\"><a href=\"#/page?file=en%2Fevents-list%2Findex.html\">Events</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4058\"><a href=\"#/page?file=index__p%3D3926.html\">News</a></li>\n</ul>\n</li>\n<li class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-has-children menu-item-5606\"><a href=\"#/page?file=index__p%3D3930.html&amp;anchor=0\">Resources</a>\n<ul class=\"sub-menu\">\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4060\"><a href=\"#/page?file=index__p%3D3924.html\">For Youth</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4063\"><a href=\"#/page?file=index__p%3D4009.html\">Canadian Law</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-5620\"><a href=\"#/page?file=index__p%3D5618.html\">Other</a></li>\n</ul>\n</li>\n<li class=\"menu-item menu-item-type-custom menu-item-object-custom menu-item-has-children menu-item-5607\"><a href=\"#/page?file=index__p%3D3930.html&amp;anchor=0\">Donate</a>\n<ul class=\"sub-menu\">\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4062\"><a href=\"#/page?file=index__p%3D3937.html\">How to Donate</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4061\"><a href=\"#/page?file=index__p%3D3973.html\">Partners</a></li>\n</ul>\n</li>\n<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4059\"><a href=\"#/page?file=index__p%3D3940.html\">FAQ</a></li>\n<li class=\"lang-item lang-item-69 lang-item-ko lang-item-first menu-item menu-item-type-custom menu-item-object-custom menu-item-5632-ko\"><a href=\"#/page?file=index__p%3D492.html\" hreflang=\"ko-KR\" lang=\"ko-KR\"><img src=\"data:image/png;base64,\" alt=\"한국어\" width=\"16\" height=\"11\" style=\"width: 16px; height: 11px;\" loading=\"lazy\"></a></li>\n</ul>\t\t\t\t</nav>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>  </header>\n<!-- = Page banner area start = \\-->\n<section class=\"grop-banner-area grop-page_banner_height-200 \" style=\"background-image: url(&quot;./archive/wp-content/uploads/2020/03/2_banner_services.jpg&quot;); background-position: center center; background-size: cover; background-attachment: ;\">\n\t<div class=\"overlay\" style=\"background-color:rgba(0,0,0,0.3);\"></div>\n\t<div class=\"grop-full_height  container\">\n\t\t<h2 class=\"grop-vertical_middle  text-uppercase  grop-page_title\">Love Toronto Programs and Services</h2>\n\t</div>\n\t<!--banner overly start\\-->\n\t<div class=\"grop-page_banr_overly_opc-30\"></div><!--/banner overly end-->\n</section>\n\n<div class=\"grop-page container padding-cnt-no grop-full-width\" style=\"\">\n\t<div class=\"no-sidebar\">\n\t\t<div class=\"wpb-content-wrapper\"><div class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1586887877056\"><div class=\"wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner \"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_raw_code wpb_content_element wpb_raw_html\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<div id=\"section_1\" style=\"position: absolute; top: -100px;\">\n&nbsp;\n</div>\n\t\t</div>\n\t</div>\n<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\" data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\" data-restored-gallery=\"\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/card_3.jpg\" alt=\"\" loading=\"lazy\"><h5 class=\"text-center  grop-oimt_cption\"></h5></div></div></div><div class=\"grop-fix  grop-oimt_txt\"><h3>Legal Counsel Referral Service</h3><p class=\"grop-oimt_semi\">Our legal counseling program aims to help Koreans who have limited information and access to legal assistance. This service is to focus on providing appropriate information rather than representing clients in the court.</p><p>Cases available<br>\nSmall Claim Court (information only) Family Law (information only) Criminal Law (information only) Land Tenancy Board (information only) Immigration (information only)</p>\n<p>How to apply for Legal Counsel Referral Service<br>\nPlease fill out a “service request” on our Love Toronto Homepage with your case or situation in details you would like to discuss. One of our attorneys will respond back to you by email or phone call. In case you need to talk face to face, your assigned attorney will contact you to make an in-person appointment. If you are having trouble with online requests, please ask our program coordinator for help.</p>\n<p><b>Steps to Justice</b><br>\nCLEO has dedicated the Steps to Justice <a>https://stepstojustice.ca/</a> to provide reliable and practical information on common legal problems.</p><a class=\"grop-btn grop-btn_overly grop-grop-oimtrm_btn\" href=\"#/page?file=en%2Fcontact%2Findex__menu%3Dcontact-1.html\"><span>Contact Us</span></a></div></div></div></div></div></div><div class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1586887724208\"><div class=\"wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner \"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_raw_code wpb_content_element wpb_raw_html\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<div id=\"section_2\" style=\"position: absolute; top: -100px;\">\n&nbsp;\n</div>\n\t\t</div>\n\t</div>\n<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\" data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\" data-restored-gallery=\"\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/card_2.jpg\" alt=\"\" loading=\"lazy\"><h5 class=\"text-center  grop-oimt_cption\"></h5></div></div></div><div class=\"grop-fix  grop-oimt_txt\"><h3>Psychotherapeutic counseling referral service</h3><p class=\"grop-oimt_semi\">Psychotherapeutic counseling referral service is to provide accessibility for Koreans who have difficulties with accessing mental health care assistants in Canada. Love Toronto provides a counseling service for your mental health and any types of anxiety disorder such as depression, bipolar disorder, or insomnia you may have.</p>\n<p>Certain situations you may feel difficult to manage on your own can also be consulted. For example, stress occurring from seeking a job, studying, or such relationship problems with your partner, children, or co-workers.</p><p><strong>Application:</strong> You will be assigned to our one of cooperating therapists after applying through the ``Contact Form” on our website.</p>\n<p>We connect clients and our cooperating therapists to book an appointment for private counseling. Love Toronto also financially supports a portion of the consultation fees for clients who are financially suffering and have no access to service.</p>\n<p>※ We transfer subsidies for consultation directly to our therapists, but there may be additional fee depending on the number of appointments.</p><a class=\"grop-btn grop-btn_overly grop-grop-oimtrm_btn\" href=\"#/page?file=en%2Fcontact%2Findex__menu%3Dcontact-3.html\"><span>Contact Us</span></a></div></div>\n\t<div class=\"wpb_raw_code wpb_raw_js\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t\n\t\t</div>\n\t</div>\n</div></div></div></div><div class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1586887724208\"><div class=\"wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner \"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_raw_code wpb_content_element wpb_raw_html\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<div id=\"section_4\" style=\"position: absolute; top: -100px;\">\n&nbsp;\n</div>\n\t\t</div>\n\t</div>\n<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\" data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\" data-restored-gallery=\"\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"./archive/wp-content/uploads/2026/01/800_Senior-Service-3-1.jpg\" alt=\"\" loading=\"lazy\"><h5 class=\"text-center  grop-oimt_cption\"></h5></div></div></div><div class=\"grop-fix  grop-oimt_txt\"><h3>Senior Community Services</h3><p class=\"grop-oimt_semi\">Love Toronto's Senior Community Services is a free outreach program to support seniors who experience loneliness or social isolation. Through home visits, regular phone calls, and group programs, we provide emotional support, encourage meaningful social engagement, and connect seniors with community resources and services so they can continue living safely, independently, and with confidence.</p><p>Our Programs:</p>\n<p><strong>Friendly Visiting:</strong> Trained volunteers visit seniors on a regular basis to provide companionship and meaningful social interaction. Through friendly conversations and ongoing visits, volunteers offer emotional support, check on each senior's well-being, and help identify any changes in their daily lives. When additional support is needed, seniors can be referred to appropriate community programs and social services.</p>\n<p><strong>Phone Reassurance:</strong> For seniors who have difficulty going out or have limited opportunities for social interaction, trained volunteers provide regular check-in phone calls. These conversations help reduce feelings of loneliness and social isolation while offering reassurance and emotional support. Volunteers also help identify concerns early and connect seniors with appropriate community resources when needed.</p>\n<p><strong>Senior Class:</strong> Senior Class is a free group program where older adults can learn, connect, and engage in meaningful activities together. Programs include art, music, cognitive wellness activities, and other group sessions designed to promote wellness physically and mentally. By encouraging social interaction and active participation, Senior Class helps seniors build friendships and foster a sense of belonging.</p>\n<p>※ Seniors may apply directly or be referred by community agencies, social workers, healthcare professionals, family members, or friends. Once an application is received, a staff member will contact the applicant to arrange an intake consultation and assessment.</p>\n<p>※ All volunteers are carefully screened, trained, and supervised in accordance with Ontario’s legal and ethical standards. We are committed to providing a safe, respectful, and trustworthy service that seniors and their families can rely on.</p>\n<p><b>Korean Meals on Wheels: TheraMeals</b></p>\n<p>Love Toronto supports the GTA Korean Meals on Wheels Program operated by TheraMeals, for Korean seniors who need access to healthy, balanced meals.</p>\n<p>This meal service is directly operated and provided by TheraMeals. For more information about the service and how to apply, please visit the TheraMeals <a>https://www.therameals.ca/contact</a>.</p><a class=\"grop-btn grop-btn_overly grop-grop-oimtrm_btn\" href=\"#/page?file=en%2Fcontact%2Findex__menu%3Dcontact-7.html\"><span>Contact Us</span></a></div></div></div></div></div></div><div class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1784555115539\"><div class=\"wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner \"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_raw_code wpb_content_element wpb_raw_html\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<div id=\"section_5\" style=\"position: absolute; top: -100px;\">\n&nbsp;\n</div>\n\t\t</div>\n\t</div>\n<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\" data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\" data-restored-gallery=\"\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"./archive/wp-content/uploads/2026/06/Funded-in-part-by_Canada_WordmarkNHSP-EN-8.png\" alt=\"\" loading=\"lazy\"><h5 class=\"text-center  grop-oimt_cption\"></h5></div></div></div><div class=\"grop-fix  grop-oimt_txt\"><h3>New Horizons for Seniors Program (NHSP)</h3><p>The Senior Community Service of Love Toronto is supported by the New Horizons for Seniors Program (NHSP).</p></div></div></div></div></div></div><div class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1586887886085\"><div class=\"wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner \"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_raw_code wpb_content_element wpb_raw_html\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<div id=\"section_3\" style=\"position: absolute; top: -100px;\">\n&nbsp;\n</div>\n\t\t</div>\n\t</div>\n<div class=\"grop-fix grop-oimt_warp\"><div class=\"grop-float_left  grop-oimt_crosl_warp\"><div class=\"owl-carousel  grop-oimt_carousel\" data-loop=\"true\" data-items=\"5\" data-margin=\"30\" data-mouse-drag=\"true\" data-dots=\"true\" data-restored-gallery=\"\"><div class=\"grop-oimt_single\"><img decoding=\"async\" src=\"./archive/wp-content/uploads/2020/03/card_4.jpg\" alt=\"\" loading=\"lazy\"><h5 class=\"text-center  grop-oimt_cption\"></h5></div></div></div><div class=\"grop-fix  grop-oimt_txt\"><h3>ADULT DAY PROGRAM</h3><p class=\"grop-oimt_semi\">Ariang Adult Day Program was founded by Arirang Age-Friendly Community Centre and is operating by CHATS in the Milal church building. It is open from 9:00 AM to 3:00 PM every Tuesday and Friday, and about 25 seniors are currently registered. We hope this program can be helpful for our community, where seniors can have various activities and socializing opportunities while their family members can have spare time from taking care of seniors with disadvantage.</p><p><strong>How to Apply:</strong> You need to submit an application form from your family doctor office and submit to the ADP through your family doctor. Please note that the priority goes for seniors who are in the early stages of dementia or who have physical disadvantages. Please be mindful that here maybe longer waiting times due to unexpected waitlists.</p>\n<p><b>NYSC ADP</b></p>\n<p>The Korean Adult Day Program, operated in partnership between North York Seniors Centre (NYSC) and Love Toronto Korean-Canadian Community Services, will begin on September 30, 2026.</p>\n<p>The program will be held every Wednesday from 9:30 a.m. to 3:00 p.m. (a total of 5.5 hours) at NYSC and will serve approximately 10 Korean seniors.</p>\n<p>The program aims to provide seniors who require assistance with daily living with opportunities for various activities and social interaction. It also provides family caregivers with time to rest and helps reduce the burden of caring for their loved ones at home.</p>\n<p>※A Referral Letter from the senior’s Family Physician or an approved healthcare provider is required to participate in the program. Eligibility will be determined through NYSC’s intake assessment and evaluation process. Priority may be given based on the senior’s health condition, level of support required, and program capacity. As space is limited, a waiting list may apply.</p>\n<p><b>Program Location</b>:<br>\nNorth York Seniors Centre (NYSC)<br>\n21 Hendon Avenue<br>\nToronto, ON M2M 4G8</p><a class=\"grop-btn grop-btn_overly grop-grop-oimtrm_btn\" href=\"#/page?file=en%2Fcontact%2Findex__menu%3Dcontact-4.html\"><span>Contact Us</span></a></div></div></div></div></div></div><div data-vc-full-width=\"true\" data-vc-full-width-init=\"false\" class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1695996930081 vc_row-has-fill\"><div class=\"wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner vc_custom_1695996922839\"><div class=\"wpb_wrapper\"><div class=\"grop-callout_area  grop-parlx-6ad190419a343\"><div class=\"grop-vertical_middle  grop-fix grop-callout_container   vc_custom_1586293329514\"><div class=\"grop-cta-cnt style-two\"><div class=\"text-left text-uppercase  grop-hm3callout_txt\"><p style=\"font-size: 14px; line-height: 24px;\"><img decoding=\"async\" class=\"size-full wp-image-2748 alignleft\" src=\"./archive/wp-content/uploads/2020/03/ic_book.png\" alt=\"\" width=\"65\" loading=\"lazy\"><span style=\"font-size: 24px; font-weight: bold;\">Korean-translated Canadian Legal Information Booklets</span></p>\n<p style=\"font-size: 14px; line-height: 24px;\">With a permission from Community Legal Education Ontario (CLEO), it was translated into Korean by our volunteers and reviewed by Love Toronto advisory attorney.</p>\n</div></div><div class=\"grop-float_right grop-callout_btn_warp\"><div class=\"calout-btn\"><a class=\"grop-btn grop-btn_overly grop-callout_btn grop-btn-6ad190419a4a3-see-details   vc_custom_1604246216637\" href=\"#/page?file=en%2Flawbook.html\"><span>See Details</span></a></div></div></div></div></div></div></div></div><div class=\"vc_row-full-width vc_clearfix\"></div>\n</div>\n\t\t\t</div><!-- Content Area -->\n\t</div>\n\n\t<footer class=\"grop-footer_area\">\n\t\t<!-- Footer Widgets -->\n<div class=\"grop-footer_top_widgets_warp\">\n\t<div class=\"container\">\n\t\t<div class=\"row grop-footer_widgets\">\n\t\t\t<div class=\"col-md-4\"><div class=\"footer-title-2 grop-ftr_sngl_widget vt-text-widget\"><h4 class=\"grop-ftr_widget_title\">Love Toronto</h4><p class=\"grop-txt-block \">Charitable Organization 70955 4893 RR 0001</p>\n<p class=\"grop-txt-block \">#204-5915 Leslie Street, North York, ON M2H 1J8</p>\n<address class=\"grop-ftr_wigt_locn \"><span class=\" grop-footer-adrs-6ad190419adcf\">Email: <a href=\"mailto:lovetoronto.office@gmail.com\" target=\"_blank\">lovetoronto.office@gmail.com</a></span><span class=\" grop-footer-adrs-6ad190419ade2\">Phone: <a href=\"tel:+16473465688\">+1 647-346-5688</a></span>\n<span class=\" grop-footer-adrs-6ad190419adef\">Fax: +1 647-794-1151</span></address>\n<div class=\"clear\"></div></div> <!-- end widget --><div class=\" grop-ftr_sngl_widget widget_polylang\"><ul>\n\t<li class=\"lang-item lang-item-69 lang-item-ko lang-item-first\"><a lang=\"ko-KR\" hreflang=\"ko-KR\" href=\"#/page?file=index__p%3D492.html\"><img src=\"data:image/png;ba