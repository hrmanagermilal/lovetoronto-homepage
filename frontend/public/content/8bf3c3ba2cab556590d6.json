=\"lazy\"></span>\n<div id=\"tribe-events-content\" class=\"tribe-events-single\">\n\n\t<p class=\"tribe-events-back\">\n\t\t<a href=\"#/page?file=events-list%2Findex.html\"> « 전체 이벤트</a>\n\t</p>\n\n\t<!-- Notices -->\n\t\n\t<h1 class=\"tribe-events-single-event-title\">마음동창회 (2021-02-20) | On-line workshop</h1>\n\t<div class=\"tribe-events-schedule tribe-clearfix\">\n\t\t<h2><span class=\"tribe-event-date-start\">2021-02-20@7:00 오후</span>-<span class=\"tribe-event-date-end\">2021-03-27@9:30 오후</span></h2>\t</div>\n\n\t<!-- Event header -->\n\t<div id=\"tribe-events-header\" data-title=\"마음동창회 (2021-02-20) - 러브 토론토 (Love Toronto)\" data-viewtitle=\"마음동창회 (2021-02-20)\">\n\t\t<!-- Navigation -->\n\t\t<nav class=\"tribe-events-nav-pagination\" aria-label=\"이벤트 네비게이션\">\n\t\t\t<ul class=\"tribe-events-sub-nav\">\n\t\t\t\t<li class=\"tribe-events-nav-previous\"><a href=\"#/page?file=index__p%3D3857.html\"><span>«</span> 이전</a></li>\n\t\t\t\t<li class=\"tribe-events-nav-next\"><a href=\"#/page?file=index__p%3D4359.html\">다음 <span>»</span></a></li>\n\t\t\t</ul>\n\t\t\t<!-- .tribe-events-sub-nav -->\n\t\t</nav>\n\t</div>\n\t<!-- #tribe-events-header -->\n\n\t\t\t<div id=\"post-4311\" class=\"post-4311 tribe_events type-tribe_events status-publish has-post-thumbnail hentry\">\n\t\t\t<!-- Event featured image, but exclude link -->\n\t\t\t<div class=\"tribe-events-event-image\"><img width=\"720\" height=\"960\" src=\"./archive/wp-content/uploads/2021/01/%EB%A7%88%EC%9D%8C%EB%8F%99%EC%B0%BD%ED%9A%8C.jpg\" class=\"attachment-full size-full wp-post-image\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" sizes=\"(max-width: 720px) 100vw, 720px\" loading=\"lazy\"></div>\n\t\t\t<!-- Event content -->\n\t\t\t\t\t\t<div class=\"tribe-events-single-event-description tribe-events-content\">\n\t\t\t\t<p><strong><em>중년 기혼 남성을 위한 프로그램</em></strong></p>\n<p><strong>마음 동창회</strong></p>\n<p>&nbsp;</p>\n<p><strong><em>캐</em></strong>나다 한인 커뮤니티의 건강한 가정의 중요성과 예방 &amp; 회복을 위한 다양한 프로그램을 제공하고 있는 <strong>Love Family</strong>에서 2021년 아래와 같이 전세계 최초로 마음 동창회를 개최 하오니 관심있는 분들의 많은 참여바랍니다.</p>\n<p><strong>▣ </strong><strong>일 </strong><strong>&nbsp;&nbsp;시: </strong>2021년 2월 20일(토) ~ 3월 27일(토) 19:00-21:30</p>\n<p><strong>▣ </strong><strong>방 </strong><strong>&nbsp;&nbsp;법: </strong>Online(zoom을 이용한 실시간 진행)</p>\n<p><strong>▣ </strong><strong>진 </strong><strong>&nbsp;&nbsp;행: </strong>김인철(Love Family), 김동준(캐나다 마음사랑)</p>\n<p><strong>▣ </strong><strong>회 </strong><strong>&nbsp;&nbsp;비:</strong> $20</p>\n<p><strong>▣ </strong><strong>주 </strong><strong>&nbsp;&nbsp;최:</strong> Love Family &amp; Love Toronto</p>\n<p><strong>▣ </strong><strong>문의 및 신청</strong><strong>:</strong> 김인철(email 또는 문자메시지)</p>\n<p>647-880-9891/chrisikim@gmail.com)</p>\n<p>&nbsp;</p>\n<p><strong></strong></p><div class=\"wp-block-button\"><strong>\n<a data-e-disable-page-transition=\"true\" class=\"dlm-download-link dlm-download-default wp-block-button__link wp-element-button\" title=\"\" href=\"./archive/download/4318/document.pdf\" rel=\"noopener\" id=\"download-link-4318\" data-redirect=\"false\" type=\"application/pdf\" target=\"_blank\" data-document=\"pdf\">\n\t마음동창회안내문 (2021-02-20)\t(2460 downloads\t)\n</a>\n</strong></div><strong>\n 마음동창회 안내문</strong><p></p>\n\t\t\t</div>\n\t\t\t<!-- .tribe-events-single-event-description -->\n\t\t\t<div class=\"tribe-events tribe-common\">\n\t<div class=\"tribe-events-c-subscribe-dropdown__container\">\n\t\t<div class=\"tribe-events-c-subscribe-dropdown\">\n\t\t\t<div class=\"tribe-common-c-btn-border tribe-events-c-subscribe-dropdown__button\">\n\t\t\t\t<svg class=\"tribe-common-c-svgicon tribe-common-c-svgicon--cal-export tribe-events-c-subscribe-dropdown__export-icon\" aria-hidden=\"true\" viewBox=\"0 0 23 17\" xmlns=\"http://www.w3.org/2000/svg\">\n\t<path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M.128.896V16.13c0 .211.145.383.323.383h15.354c.179 0 .323-.172.323-.383V.896c0-.212-.144-.383-.323-.383H.451C.273.513.128.684.128.896Zm16 6.742h-.901V4