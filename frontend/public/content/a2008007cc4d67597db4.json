p%3D2928.html\">\n              <i class=\"fa fa-plus\"></i>\n            </a><!--/plus btn end-->\n        </div>\n      </div>\n    </div><!--/ end-->\n<div class=\"grop-related_project\"><h3 class=\"grop-rtdpjct-title\">Related Projects</h3><div class=\"row\">  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2860.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_4mainReps-360x234.jpg\" alt=\"유지 보수 및 수리\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2860.html\">유지 보수 및 수리</a>\n        </h4>\n        <p>모든 세입자는 청결하고 안전한 건물에서 잘 유지되는 집에 대한 권리를 가집니다. 이 자료는 집주인이 해야하는 유지 보수 및 수리 유형을 설명하고, 세입자가 물건을 고치기위해 취할 수있는 단계 및 세입자가 도움을받을 수있는 방법을 설명합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/mainreps\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3386/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2860.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2899.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_2harassE-360x234.jpg\" alt=\"괴롭힘 및 차별\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2899.html\">괴롭힘 및 차별</a>\n        </h4>\n        <p>세입자는 프라이버시에 대한 법적 권리와 집주인이나 다른 세입자의 괴롭힘과 차별을 당하지 않을 권리가 있습니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/harass-e\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3348/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div>\n<p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2899.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2907.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_5moving-360x234.jpg\" alt=\"이사 나가기\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2907.html\">이사 나가기</a>\n        </h4>\n        <p>이 자료는 이사하는 경우 세입자가 해야 할 일과 규칙을 준수하지 않을 경우 발생할 수있는 상황을 설명합니다. 일찍 퇴거하는 방법을 다루는 섹션이 있습니다. 집주인과 계약을 맺고, 집주인을 임명하고, 집주인과 세입자위원회에 신청하는 방법입니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/moving-notice\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3392/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2907.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2897.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_1careHome-360x234.jpg\" alt=\"간병시설\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2897.html\">간병시설</a>\n        </h4>\n        <p>간호 주택은 건강 관리 서비스, 간병 서비스 또는 일상 생활에 도움이 되는 임대 주택입니다. 이 간행물은 누군가가 간병인 임차인인지 알아보고 간병인의 권리를 설명합니다. 정보 패키지, 임차 계약, 임대료, 서비스 및 퇴거 등과 같은 주제를 다룹니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/carehome\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3325/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2897.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2925.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_6rentIncs-360x234.jpg\" alt=\"임대료 인상\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2925.html\">임대료 인상</a>\n        </h4>\n        <p>세입자의 집세를 늘리려면 집주인은 주거용 주택법에 의해 정해진 규칙을 따라야합니다. 이 자료는 이러한 규칙을 설명합니다. 또한 집주인과 세입자가 임대료를 높이기 위해 할증료 및 기타 요금에 관한 규칙을 세울 수 있고, 세입자가 불법 임대료를 청구 할 경우 취할 수있는 조치에 대해 설명합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/rentincs\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3399/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2925.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2978.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_8fightEv-360x234.jpg\" alt=\"퇴거 명령에 대한 대처법\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2978.html\">퇴거 명령에 대한 대처법</a>\n        </h4>\n        <p>이 자료는 집을 떠나거나 퇴거 당하고 싶지 않은 경우 세입자가 해야 할 일, 집주인 및 임차인위원회 청문회에서 어떤 일이 일어나는지, 이사회에서 퇴거 명령을 받는 경우 세입자가 할 수 있는 일을 설명합니다. 더 자세한 정보나 법적 도움을 얻을 수 있는 연락처 정보도 있습니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/fightev\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3415/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2978.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n</div></div>\t\t\t\t\t\t</footer>\n\t\t\t\t\t</div>\n\t\t\t\t\t</article>\n\t</div>\n\n\t<footer class=\"grop-footer_area\">\n\t\t<!-- Footer Widgets -->\n<div