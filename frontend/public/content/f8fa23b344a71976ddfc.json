{"html":"\n\t\n\n\t\t\t\t<h1 class=\"screen-reader-text\">로그인</h1>\n\t\t\t<div id=\"login\">\n\t\t<h1 role=\"presentation\" class=\"wp-login-logo\"><a href=\"#/page?file=index.html\">러브 토론토 (Love Toronto)</a></h1>\n\t\n\t\t<form name=\"loginform\" id=\"loginform\">\n\t\t\t<p>\n\t\t\t\t<label for=\"user_login\">사용자명 또는 이메일 주소</label>\n\t\t\t\t<input type=\"text\" name=\"log\" id=\"user_login\" class=\"input ltr\" value=\"\" size=\"20\" autocapitalize=\"off\" autocomplete=\"username\" required=\"required\">\n\t\t\t</p>\n\n\t\t\t<div class=\"user-pass-wrap\">\n\t\t\t\t<label for=\"user_pass\">비밀번호</label>\n\t\t\t\t<div class=\"wp-pwd\">\n\t\t\t\t\t<input type=\"password\" name=\"pwd\" id=\"user_pass\" class=\"input password-input ltr\" value=\"\" size=\"20\" autocomplete=\"current-password\" spellcheck=\"false\" required=\"required\">\n\t\t\t\t\t<button type=\"button\" class=\"button button-secondary wp-hide-pw hide-if-no-js\" data-toggle=\"0\" aria-label=\"비밀번호 표시\" disabled=\"disabled\">\n\t\t\t\t\t\t<span class=\"dashicons dashicons-visibility\" aria-hidden=\"true\"></span>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\t<div hidden=\"\" class=\"wpsec_captcha_wrapper\">\n\t\t\t<div class=\"wpsec_captcha_image\"></div>\n\t\t\t<label for=\"wpsec_captcha_answer\">\n\t\t\tType in the text displayed above\t\t\t</label>\n\t\t\t<input type=\"text\" class=\"wpsec_captcha_answer\" name=\"wpsec_captcha_answer\" value=\"\">\n\t\t</div>\n\t\t\t\t\t\t\t\t<p class=\"forgetmenot\">\n\t\t\t\t<input name=\"rememberme\" type=\"checkbox\" id=\"rememberme\" value=\"forever\">\n\t\t\t\t<label for=\"rememberme\">기억하기</label>\n\t\t\t\t<span class=\"wp-tooltip wp-is-toggletip\">\n\t\t\t\t<button aria-haspopup=\"dialog\" aria-label=\"도움말\" class=\"wp-tooltip__toggle\" popovertarget=\"rememberme-help-toggletip\" type=\"button\" disabled=\"disabled\"><span aria-hidden=\"true\" class=\"dashicons dashicons-editor-help\"></span></button>\n\t\t\t\t<span popover=\"auto\" id=\"rememberme-help-toggletip\" class=\"wp-tooltip__bubble\" role=\"dialog\" aria-label=\"도움말\" tabindex=\"-1\" autofocus=\"\"><span id=\"rememberme-help-toggletip-text\" class=\"wp-tooltip__text\">Selecting \"Remember Me\" increases the length of time until you’re asked to log in again on this device. To keep your account secure, use this option only on your personal devices.</span><button type=\"button\" class=\"wp-tooltip__close\" popovertarget=\"rememberme-help-toggletip\" popovertargetaction=\"hide\" aria-label=\"닫기\" disabled=\"disabled\"><span class=\"dashicons dashicons-no-alt\" aria-hidden=\"true\"></span></button></span></span>\t\t\t</p>\n\t\t\t<p class=\"submit\">\n\t\t\t\t<input type=\"submit\" name=\"wp-submit\" id=\"wp-submit\" class=\"button button-primary button-large\" value=\"로그인\" disabled=\"disabled\">\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"redirect_to\" value=\"https://lovetoronto.org/wp-admin/\">\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"testcookie\" value=\"1\">\n\t\t\t</p>\n\t\t</form>\n\n\t\t\t\t\t<p id=\"nav\">\n\t\t\t\t<a class=\"wp-login-lost-password\" href=\"https://lovetoronto.org/wp-login.php?action=lostpassword\" target=\"_blank\" rel=\"noopener noreferrer\">비밀번호를 잊으셨나요?</a>\t\t\t</p>\n\t\t\t\n\t\t<p id=\"backtoblog\">\n\t\t\t<a href=\"#/page?file=index.html\">← 러브 토론토 (Love Toronto)(으)로 가기</a>\t\t</p>\n\t\t\t</div>\n\t\t\t\t<div class=\"language-switcher\">\n\t\t\t\t<form id=\"language-switcher\">\n\n\t\t\t\t\t<label for=\"language-switcher-locales\">\n\t\t\t\t\t\t언어<span class=\"dashicons dashicons-translation\" aria-hidden=\"true\"></span>\n\t\t\t\t\t</label>\n\n\t\t\t\t\t<select name=\"wp_lang\" id=\"language-switcher-locales\"><option value=\"en_US\" lang=\"en\" data-installed=\"1\">English (United States)</option>\n<option value=\"en_CA\" lang=\"en\" data-installed=\"1\">English (Canada)</option>\n<option value=\"ko_KR\" lang=\"ko\" selected=\"selected\" data-installed=\"1\">한국어</option></select>\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t<input type=\"submit\" class=\"button\" value=\"변경\" disabled=\"disabled\">\n\n\t\t\t\t\t</form>\n\t\t\t\t</div>\n\t\t\t\n\t\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\t\n\t\n\t","stylesheets":[{"href":"./content/styles/749fb534e4e58be001aa.css","media":"all"},{"href":"./content/styles/5cae2b6e82b7bdef6833.css","media":"all"},{"href":"./content/styles/fe06e445e6050a140df1.css","media":"all"},{"href":"./content/styles/e4852d926272d707c3d7.css","media":"all"},{"href":"./content/styles/8a77610fd0190ea9ecb5.css","media":"all"},{"href":"./content/styles/8e7773ccad1f97b37f02.css","media":"all"},{"href":"./content/styles/875a0db46384aa33daa5.css","media":"all"},{"href":"./content/styles/6273868dd821cc6fc522.css","media":"all"},{"href":"./content/styles/cc32b8a2e8b99572cca6.css","media":"all"},{"href":"./content/styles/d17526c68a8435c5e437.css","media":"all"}],"sliders":[],"bodyClass":"login no-js login-action-login wp-core-ui admin-color-modern locale-ko-kr"}