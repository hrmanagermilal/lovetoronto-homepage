{"html":"\n<div id=\"grop_page\" class=\"\"> <!-- #vtheme-wrapper -->\n  <header class=\"grop-header_area \">\n    <!--  header top bar start  \\-->\n    <div class=\"grop-header_navigations  sticky-header grop-header_sticky\">\n\t<div class=\"container\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-sm-2 col-xs-6 grop-logo-br\">\n\t\t\t\t<div class=\"grop-hadr_logos  hav-default-logo hav-default-retina-logo hav-mobile-logo dhav-meta-logo dhav-meta-retina\" style=\"padding-top:10px;padding-bottom:10px;\">\n\t<a href=\"#/page?file=en%2Findex.html\" class=\"grop-logo retina-logo\"><img src=\"./archive/wp-content/uploads/2020/03/lovetoronto_logo_w_200-1.png\" height=\"65px\" alt=\"\" loading=\"lazy\"></a>\n\t\t\t\t\t<a href=\"#/page?file=en%2Findex.html\" class=\"grop-logo  thop-default-logo default-logo\"><img src=\"./archive/wp-content/uploads/2020/03/lovetoronto_logo_w_200-1.png\" alt=\"러브 토론토 (Love Toronto)\" height=\"65px\" loading=\"lazy\"></a><a href=\"#/page?file=en%2Findex.html\" class=\"grop-logo mobile-logo\"><img src=\"./archive/wp-content/uploads/2020/03/lovetoronto_logo_w_200-1.png\" alt=\"\" loading=\"lazy\"></a>\n\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-sm-10 col-xs-6 grop-nav-br\">\n\t\t\t\t<div class=\"grop-float_right grop-naviga_btns\">\n  \t\t\t\t<a class=\"grop-btn grop-btn_overly grop-hadr_donate_btn\" href=\"#/page?file=en%2Fcontact.html\"><span>Contact</span></a>\t\t\t\t</div><!--  header nav right side btns end-->\n\t\t\t\t<div class=\"grop-mobil_menu_warp\"><ul id=\"grop-mobil_menu\" class=\"slimmenu\"><li id=\"menu-item-4054\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4054\"><a href=\"#/page?file=index__p%3D3929.html\">Vision &amp; Mission</a></li>\n<li id=\"menu-item-4053\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-4053\"><a href=\"#/page?file=index__p%3D3930.html\">Services</a>\n<ul class=\"sub-menu\">\n\t<li id=\"menu-item-5725\" cla