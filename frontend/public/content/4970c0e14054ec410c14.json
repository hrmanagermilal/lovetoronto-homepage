menu-item-3447\"><a href=\"#/page?file=index__p%3D3420.html\">후원 방법</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-3117\"><a href=\"#/page?file=index__p%3D603.html\">협력상담사</a></li>\n\t<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-4499\"><a href=\"#/page?file=index__p%3D4496.html\">협력단체</a></li>\n</ul>\n</li>\n<li class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-3112\"><a href=\"#/page?file=index__p%3D2872.html\">자주 묻는 질문</a></li>\n<li class=\"lang-item lang-item-72 lang-item-en no-translation lang-item-first menu-item menu-item-type-custom menu-item-object-custom menu-item-5635-en\"><a href=\"#/page?file=en%2Findex.html\" hreflang=\"en-CA\" lang=\"en-CA\"><img src=\"data:image/png;base64,\" alt=\"English\" width=\"16\" height=\"11\" style=\"width: 16px; height: 11px;\" loading=\"lazy\"></a></li>\n</ul>\t\t\t\t</nav>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>  </header>\n<!-- = Page banner area start = \\-->\n<section class=\"grop-banner-area grop-page_banner_height-200 \" style=\"background-image: url(&quot;./archive/wp-content/uploads/2017/09/3_banner_lawbooks.jpg&quot;); background-repeat: no-repeat; background-position: center center; background-size: cover; background-attachment: ;\">\n\t<div class=\"overlay\" style=\"background-color:rgba(0,0,0,0.3);\"></div>\n\t<div class=\"grop-full_height  container\">\n\t\t<h2 class=\"grop-vertical_middle  text-uppercase  grop-page_title\">캐나다 법률정보 책자 | 주택임대차법</h2>\n\t</div>\n\t<!--banner overly start\\-->\n\t<div class=\"grop-page_banr_overly_opc-30\"></div><!--/banner overly end-->\n</section>\n<div class=\"grop-page container grop-page-with_sidbr_warp padding-none grop-hide-sidebar\" style=\"\">\n\t<article class=\"grop-float_left  grop-page-with_sidbr_entry_content\">\n\t\t\t\t\t\t\t<div id=\"post-2925\" class=\"grop-project_single_warp post-2925 project type-project status-publish has-post-thumbnail hentry project_category-category-1\">\n\t\t\t\t\t\t<header class=\"grop-pjctsigle_header\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"grop-projct_media\">\n\t\t\t\t\t\t\t\t<img src=\"./archive/wp-content/uploads/2020/03/book_housing_6rentIncs.jpg\" alt=\"임대료 인상\" loading=\"lazy\">\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<h2 class=\"grop-pjctsigle_title\">임대료 인상</h2>\t\t\t\t\t\t</header>\n\t\t\t\t\t\t\t<div class=\"grop-pjctsigle_content\">\n\t\t\t\t\t\t\t\t\t<div class=\"wpb-content-wrapper\"><div class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1585879267667\"><div class=\"wpb_column vc_column_container text-center vc_col-sm-12 vc_col-lg-offset-4 vc_col-lg-4\"><div class=\"vc_column-inner \"><div class=\"wpb_wrapper\">\n\t<div class=\"wpb_raw_code wpb_content_element wpb_raw_html\">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/rentincs\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n</div>\n\t\t</div>\n\t</div>\n</div></div></div></div><div class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted\"><div class=\"wpb_column vc_column_container text-center vc_col-sm-12\"><div class=\"vc_column-inner \"><div class=\"wpb_wrapper\"></div></div></div></div><div class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted\"><div class=\"grop-col-padding-none wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner vc_custom_1507715160194\"><div class=\"wpb_wrapper\"><div class=\"panel-group\" id=\"grop-6ad190e3ed0631\" role=\"tablist\" aria-multiselectable=\"true\"><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0630\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0630\" aria-controls=\"grop-faq-6ad190e3ed0630\">처음 입주할 때</a></h4></div><div id=\"grop-faq-6ad190e3ed0630\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0630\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p><span style=\"font-weight: 400;\">일반적으로 세입자가 처음 입주할 때, 임대인이 청구할 수 있는 임대료의 금액에는 제한이 없습니다. 따라서 임대료는 세입자와 임대인이 동의하는 선에서 결정할 수 있습니다.</span></p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0631\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0631\" aria-controls=\"grop-faq-6ad190e3ed0631\">임대인은 언제 임대료를 인상할 수 있습니까?</a></h4></div><div id=\"grop-faq-6ad190e3ed0631\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0631\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p><span style=\"font-weight: 400;\">세입자가 이사한 후에, 임대인은 집세를 올리기 전에 적어도 12개월을 기다려야 합니다. 추후 인상할 경우에도 12개월의 간격이 있어야 합니다.</span></p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0632\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0632\" aria-controls=\"grop-faq-6ad190e3ed0632\">임대료 인상에 대해 언제 통지를 해야 합니까?</a></h4></div><div id=\"grop-faq-6ad190e3ed0632\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0632\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p><span style=\"font-weight: 400;\">임대인은 집세가 올라가기 최소 90일 전에 서면으로 통지해야 합니다. 통지는 임대인 세입자 위원회(LTB) 서류 중에 있습니다. 집주인이 LTB 서류을 사용하지 않더라도 모든 정보가 포함되어 있다면 통지는 여전히 유효할 수 있습니다.</span></p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0633\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0633\" aria-controls=\"grop-faq-6ad190e3ed0633\">임대료 인상 기준치</a></h4></div><div id=\"grop-faq-6ad190e3ed0633\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0633\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p><span style=\"font-weight: 400;\">대부분의 경우 임대인은 가이드라인(guideline)이라고 불리는 비율만큼만 임대료를 인상할 수 있습니다. 가이드라인은 매년 주정부가 설정합니다. 2024년 가이드라인은 2.5%입니다. 2023년 가이드라인은 2.5%였습니다.</span></p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0634\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0634\" aria-controls=\"grop-faq-6ad190e3ed0634\">가이드라인은 모든 세입자에게 적용됩니까?</a></h4></div><div id=\"grop-faq-6ad190e3ed0634\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0634\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p><span style=\"font-weight: 400;\">가이드라인 금액은 다음 사항에 적용되지 않습니다:</span></p>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">2018년 11월 15일 이전에 아무도 거주하지 않은 신축 건물 또는 건물의 일부</span></li>\n<li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">본래 2개 이하의 유닛이 포함되지 않은 주택에 2018년 11월 15일 이후에 조성된 독립형 유닛은 다음 경우일 때:</span>\n<ul>\n<li style=\"font-weight: 400;\" aria-level=\"2\"><span style=\"font-weight: 400;\">세입자가 유닛에 처음 거주하던 당시에 소유자가 그 집에 살았거나</span></li>\n<li style=\"font-weight: 400;\" aria-level=\"2\"><span style=\"font-weight: 400;\">미완공인 집에 유닛이 조성됐을 경우.</span></li>\n</ul>\n</li>\n</ul>\n<p><span style=\"font-weight: 400;\">이 경우에 임대인은 보통 자신이 선택한 금액만큼 임대료를 인상할 수 있습니다. 하지만 12개월과 90일의 기한은 여전히 적용됩니다.</span></p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0635\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0635\" aria-controls=\"grop-faq-6ad190e3ed0635\">가이드라인 이상으로 임대료를 인상할 수 있습니까?</a></h4></div><div id=\"grop-faq-6ad190e3ed0635\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0635\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p><span style=\"font-weight: 400;\">임대인은 LTB에 임대료를 가이드라인보다 더 인상할 수 있는 허가를 신청할 수 있습니다. 임대인은 인상하기 전까지 12개월을 기다려야 하며, 90일 전에 서면으로 통지해야 합니다. 이러한 임대료 인상은 Above Guideline Increase (AGI)라고 불립니다.</span></p>\n<p><span style=\"font-weight: 400;\">LTB는 2021년 임대료 동결 기간 동안에도 AGI를 허용했습니다.</span></p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0636\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0636\" aria-controls=\"grop-faq-6ad190e3ed0636\">임대인이 AGI를 신청하면 어떻게 됩니까?</a></h4></div><div id=\"grop-faq-6ad190e3ed0636\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0636\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p><span style=\"font-weight: 400;\">LTB는 결정을 위해 청문회를 가질 것입니다. 청문회는 보통 서면이나 전화나 화상통화로 진행됩니다. LTB는 청문회에 참여하는 방법과 임대인의 신청서 사본을 보낼 것입니다.</span></p>\n<p><span style=\"font-weight: 400;\">같은 건물에 있는 다른 세입자들도 영향을 받는지 확인하기 위해 신청서 사본을 확인하십시오. 증가에 맞서기 위해 협업할 수 있습니다</span></p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0637\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0637\" aria-controls=\"grop-faq-6ad190e3ed0637\">조정 위원회가 허가할 수 있는 인상 범위는 어느 정도 입니까?</a></h4></div><div id=\"grop-faq-6ad190e3ed0637\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0637\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p><span style=\"font-weight: 400;\">임대인이 자본 지출 및 보안 서비스로 인해 인상 기준치 보다 높게 임대료를 신청한 경우, LTB는 기준보다 최대 3%, 최장 3년 동안 임대료를 인상하도록 허가할 수 있습니다. 주요 수리, 개조, 교체 또는 5년 이상 유지가 되는 추가는 자본 지출이며 정상적인 지속적인 유지 보수에 해당되지 않습니다</span></p>\n<p><span style=\"font-weight: 400;\">LTB는 또한 시세와 요금이 매우 많이 인상되는 경우 제한 없는 임대료 인상을 허용할 수 있습니다.</span></p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0638\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0638\" aria-controls=\"grop-faq-6ad190e3ed0638\">불법 임대료 인상을 지불했다고 생각한다면</a></h4></div><div id=\"grop-faq-6ad190e3ed0638\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0638\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p>돈을 돌려 받으려면 <a href=\"http://tribunalsontario.ca/ltb\" target=\"_blank\" rel=\"noopener noreferrer\">tribunalsontario.ca/ltb</a>에서 LTB에 신청할 수 있습니다. 임대인이 처음 불법 임대료를 청구한 날로부터 1년 이내에 신청해야 합니다. CLEO의 T1 Guided Pathway는 신청에 필요한 서류을 작성하는 데 도움을 줄 수 있습니다. 더 많은 정보를 원하시면 <a href=\"http://stepstojustice.ca/FormT1\" target=\"_blank\" rel=\"noopener noreferrer\">stepstojustice.ca/FormT1</a> 를 방문하세요.</p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed0639\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed0639\" aria-controls=\"grop-faq-6ad190e3ed0639\">임대료 인상 규정은 온타리오의 모든 임대인에게 적용됩니까?</a></h4></div><div id=\"grop-faq-6ad190e3ed0639\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed0639\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p>이 책자는 주택 임대차 보호법(Residential Tenancy Act, RTA)에 의해 보호되는 세입자를 위한 것입니다. RTA는 온타리오 주의 대부분의 임대 주택에 적용됩니다.</p>\n<p>하지만 일부 임대 주택은 임대 주택법에 의해 보호되지 않습니다. 예를 들어, 계절별 주택에 살고 있거나, 다른 세입자로부터 임대를 받고 있거나, 임대인이나 가까운 가족과 부엌이나 욕실을 함께 사용해야 한다면 보호를 받지 못할 수도 있습니다.</p>\n<p>RTA의 보호를 받지 못하는 경우 임대 계약에 따라 임대료가 인상되지 않는 한 임대인은 원하는 만큼 언제든지 임대료를 인상할 수 있습니다.</p>\n<p>이러한 임대료 규칙이 적용되는지 확신할 수 없는 경우 법률 도움을 받는 것이 좋습니다.</p>\n\n\t\t</div>\n\t</div>\n</div></div></div><div class=\"panel panel-default  grop-faq-single\"><div class=\"panel-heading  grop-faq-heading\" role=\"tab\" id=\"grop-faqh-6ad190e3ed06310\"><h4 class=\"panel-title\"><a role=\"button\" data-toggle=\"collapse\" data-parent=\"#grop-6ad190e3ed0631\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=grop-faq-6ad190e3ed06310\" aria-controls=\"grop-faq-6ad190e3ed06310\">더 많은 도움을 받을 수 있는 곳</a></h4></div><div id=\"grop-faq-6ad190e3ed06310\" class=\"panel-collapse collapse \" role=\"tabpanel\" aria-labelledby=\"grop-faqh-6ad190e3ed06310\"><div class=\"panel-body  grop-faq-body\">\n\t<div class=\"wpb_text_column wpb_content_element \">\n\t\t<div class=\"wpb_wrapper\">\n\t\t\t<p>저소득 세입자인 경우 지역 법률 상담소에서 도움을 받을 수 있습니다. 지역 상담소를 찾으려면, 1-800-668-8258 또는 <a href=\"http://legalaid.on.ca/\" target=\"_blank\" rel=\"noopener noreferrer\">legalaid.on.ca</a> 로 Legal Aid Ontario에 연락하세요.</p>\n<p>프로보노 온타리오(Pro Bono Ontario)는 법률 자문 핫라인(1-855-255-7256)을 가지고 있습니다. 최대 30분 무료 법률 자문을 받을 수 있습니다. 핫라인은 보통 월요일부터 금요일까지 오전 9시에서 오후 5시 사이에 이용할 수 있습니다.</p>\n<p>온타리오 법률 정보 센터(Ontario Legal Information Centre)는 온타리오의 법적 상황에 직면한 모든 사람에게 30분 동안 무료로 변호사와의 면담을 제공합니다. 1-844-343-7462에 전화하여 영어나 불어로 법률 분야에 대해 변호사와 상담할 수 있습니다. 메시지를 남겨야 할 수도 있으며, 변호사가 다시 전화를 드릴 것입니다.</p>\n\n\t\t</div>\n\t</div>\n</div></div></div></div></div></div></div></div><div data-vc-full-width=\"true\" data-vc-full-width-init=\"false\" class=\"vc_row wpb_row vc_row-fluid grop-dhav-dotted vc_custom_1696013294793 vc_row-has-fill\"><div class=\"wpb_column vc_column_container text-left vc_col-sm-12\"><div class=\"vc_column-inner vc_custom_1696013289508\"><div class=\"wpb_wrapper\"><div class=\"grop-callout_area  grop-parlx-6ad190e3ed9f4\"><div class=\"grop-vertical_middle  grop-fix grop-callout_container   vc_custom_1504683801218\"><div class=\"grop-cta-cnt style-two\"><div class=\"text-left text-uppercase  grop-hm3callout_txt\"><p style=\"font-size: 14px; line-height: 24px; font-weight: 600!important; color: #222222!important;\"><img decoding=\"async\" class=\"size-full wp-image-2748 alignleft\" src=\"./archive/wp-content/uploads/2020/03/ic_law.png\" alt=\"\" width=\"75\" loading=\"lazy\">법률 정보 책자를 통해서 답을 얻지 못하셨거나, 변호사의 자문이 필요하신 경우 “법률상담 문의하기”를 통해서 질문해 주시기 바랍니다. 문의하실 경우 “상호이익 충돌방지”를 위해서 본인과 상대방의 인적사항에 관한 정보를 반드시 적어주시기 바랍니다.</p>\n</div></div><div class=\"grop-float_right grop-callout_btn_warp\"><div class=\"calout-btn\"><a class=\"grop-btn grop-btn_overly grop-callout_btn grop-btn-6ad190e3edb2f-%eb%b2%95%eb%a5%a0%ec%83%81%eb%8b%b4-%eb%ac%b8%ec%9d%98%ed%95%98%ea%b8%b0   vc_custom_1584661634422\" href=\"#/page?file=index__p%3D2925.html&amp;anchor=0\"><span>법률상담 문의하기</span></a></div></div></div></div></div></div></div></div><div class=\"vc_row-full-width vc_clearfix\"></div>\n</div>\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<!--post footer start\\-->\n\t\t\t\t\t\t<footer class=\"grop-pjctsigle_footer\">\n\n\t\t\t\t\t\t\t<!--project donors  start\\-->\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<!--social share start\\-->\n\t\t\t\t\t\t\t    <div class=\"grop-sigl_social\">\n      <div class=\"row grop-flax_vr-middle\">\n        <div class=\"text-left col-sm-5 grop-siglso_txt\">\n          <h4>Share:</h4>\n        </div>\n        <div class=\"text-right col-sm-7 grop-siglso_share\">\n          <div class=\"grop-siglso_share_warp\">\n            <ul class=\"list-inline\">\n              <li>\n                <a href=\"https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Flovetoronto.org%2Flawbook-item%2F%25ec%259e%2584%25eb%258c%2580%25eb%25a3%258c-%25ec%259d%25b8%25ec%2583%2581%2F&amp;t=%EC%9E%84%EB%8C%80%EB%A3%8C+%EC%9D%B8%EC%83%81\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa fa-facebook\"></i></a>\n              </li>\n              <li>\n                <a href=\"https://twitter.com/intent/tweet?text=%EC%9E%84%EB%8C%80%EB%A3%8C+%EC%9D%B8%EC%83%81&amp;url=https%3A%2F%2Flovetoronto.org%2Flawbook-item%2F%25ec%259e%2584%25eb%258c%2580%25eb%25a3%258c-%25ec%259d%25b8%25ec%2583%2581%2F\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa fa-twitter\"></i></a>\n              </li>\n              <li>\n                <a href=\"http://pinterest.com/pin/create/button/?url=https%3A%2F%2Flovetoronto.org%2Flawbook-item%2F%25ec%259e%2584%25eb%258c%2580%25eb%25a3%258c-%25ec%259d%25b8%25ec%2583%2581%2F&amp;media=https%3A%2F%2Flovetoronto.org%2Fwp-content%2Fuploads%2F2020%2F03%2Fbook_housing_6rentIncs.jpg\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa fa-pinterest-p\" aria-hidden=\"true\"></i></a>\n              </li>\n              <li>\n                <a href=\"https://www.linkedin.com/shareArticle?mini=true&amp;url=https%3A%2F%2Flovetoronto.org%2Flawbook-item%2F%25ec%259e%2584%25eb%258c%2580%25eb%25a3%258c-%25ec%259d%25b8%25ec%2583%2581%2F&amp;title=%EC%9E%84%EB%8C%80%EB%A3%8C+%EC%9D%B8%EC%83%81\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa fa-linkedin\"></i></a>\n              </li>\n              <li>\n                <a href=\"mailto:?subject=%EC%9E%84%EB%8C%80%EB%A3%8C+%EC%9D%B8%EC%83%81&amp;body=https%3A%2F%2Flovetoronto.org%2Flawbook-item%2F%25ec%259e%2584%25eb%258c%2580%25eb%25a3%258c-%25ec%259d%25b8%25ec%2583%2581%2F\"><i class=\"fa fa-envelope\" aria-hidden=\"true\"></i></a>\n              </li>\n            </ul>\n          </div>\n            <!--plus btn start\\-->\n            <a class=\"grop-siglso_plus\" href=\"#/page?file=index__p%3D2925.html\">\n              <i class=\"fa fa-plus\"></i>\n            </a><!--/plus btn end-->\n        </div>\n      </div>\n    </div><!--/ end-->\n<div class=\"grop-related_project\"><h3 class=\"grop-rtdpjct-title\">Related Projects</h3><div class=\"row\">  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2860.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_4mainReps-360x234.jpg\" alt=\"유지 보수 및 수리\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2860.html\">유지 보수 및 수리</a>\n        </h4>\n        <p>모든 세입자는 청결하고 안전한 건물에서 잘 유지되는 집에 대한 권리를 가집니다. 이 자료는 집주인이 해야하는 유지 보수 및 수리 유형을 설명하고, 세입자가 물건을 고치기위해 취할 수있는 단계 및 세입자가 도움을받을 수있는 방법을 설명합니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/mainreps\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3386/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2860.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2899.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_2harassE-360x234.jpg\" alt=\"괴롭힘 및 차별\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2899.html\">괴롭힘 및 차별</a>\n        </h4>\n        <p>세입자는 프라이버시에 대한 법적 권리와 집주인이나 다른 세입자의 괴롭힘과 차별을 당하지 않을 권리가 있습니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/harass-e\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3348/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div>\n<p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2899.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2907.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_5moving-360x234.jpg\" alt=\"이사 나가기\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2907.html\">이사 나가기</a>\n        </h4>\n        <p>이 자료는 이사하는 경우 세입자가 해야 할 일과 규칙을 준수하지 않을 경우 발생할 수있는 상황을 설명합니다. 일찍 퇴거하는 방법을 다루는 섹션이 있습니다. 집주인과 계약을 맺고, 집주인을 임명하고, 집주인과 세입자위원회에 신청하는 방법입니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/moving-notice\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3392/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2907.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2897.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_1careHome-360x234.jpg\" alt=\"간병시설\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2897.html\">간병시설</a>\n        </h4>\n        <p>간호 주택은 건강 관리 서비스, 간병 서비스 또는 일상 생활에 도움이 되는 임대 주택입니다. 이 간행물은 누군가가 간병인 임차인인지 알아보고 간병인의 권리를 설명합니다. 정보 패키지, 임차 계약, 임대료, 서비스 및 퇴거 등과 같은 주제를 다룹니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/carehome\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3325/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2897.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2928.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_7yourStuff-360x234.jpg\" alt=\"임대인이 세입자의 물건을 처분할 수 있을까요?\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2928.html\">임대인이 세입자의 물건을 처분할 수 있을까요?</a>\n        </h4>\n        <p>이 소책자는 이사하거나 퇴거시킬 때 뒤에 남겨둘 개인 재산에 대해 집주인이 해야 할 일을 알려줍니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/yourstuff\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3403/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2928.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n  <div class=\"col-md-4 col-sm-6\">\n    <div class=\"grop-projct_itm_warp\">\n      <div class=\"grop-projct_media_box\">\n        <a class=\"grop-cause_media_img\" href=\"#/page?file=index__p%3D2978.html\">\n          <img src=\"./archive/wp-content/uploads/2020/03/book_housing_8fightEv-360x234.jpg\" alt=\"퇴거 명령에 대한 대처법\" loading=\"lazy\">\n        </a>\n      </div>\n      <div class=\"grop-projct_content_warp\">\n        <h4>\n          <a href=\"#/page?file=index__p%3D2978.html\">퇴거 명령에 대한 대처법</a>\n        </h4>\n        <p>이 자료는 집을 떠나거나 퇴거 당하고 싶지 않은 경우 세입자가 해야 할 일, 집주인 및 임차인위원회 청문회에서 어떤 일이 일어나는지, 이사회에서 퇴거 명령을 받는 경우 세입자가 할 수 있는 일을 설명합니다. 더 자세한 정보나 법적 도움을 얻을 수 있는 연락처 정보도 있습니다.\n</p><div class=\"project-link\">\n<a class=\"grop-btn project-link-en\" href=\"https://www.cleo.on.ca/en/publications/fightev\" target=\"_blank\" rel=\"noopener noreferrer\">\n<span>원문보기</span>\n</a>\n<a class=\"grop-btn project-link-down\" href=\"./archive/download/3415/document.pdf\" target=\"_blank\" rel=\"noopener\" type=\"application/pdf\" data-document=\"pdf\">\n<span>다운받기</span>\n</a>\n</div><p></p>\n        <a class=\"grop-btn grop-btn_overly grop-vpjct_btn\" href=\"#/page?file=index__p%3D2978.html\">\n          <span>View Project</span>\n        </a>\n      </div>\n    </div>\n  </div>\n</div></div>\t\t\t\t\t\t</footer>\n\t\t\t\t\t</div>\n\t\t\t\t\t</article>\n\t</div>\n\n\t<footer class=\"grop-footer_area\">\n\t\t<!-- Footer Widgets -->\n<div class=\"grop-footer_top_widgets_warp\">\n\t<div class=\"container\">\n\t\t<div class=\"row grop-footer_widgets\">\n\t\t\t<div class=\"col-md-4\"><div class=\"footer-title-2 grop-ftr_sngl_widget vt-text-widget\"><h4 class=\"grop-ftr_widget_title\">러브 토론토</h4><p class=\"grop-txt-block \">Charitable Organization 70955 4893 RR 0001</p>\n<p class=\"grop-txt-block \">#204-5915 Leslie Street, North York, ON M2H 1J8</p>\n<address class=\"grop-ftr_wigt_locn \"><span class=\" grop-footer-adrs-6ad190e3f2760\">Email: <a href=\"mailto:lovetoronto.office@gmail.com\" target=\"_blank\">lovetoronto.office@gmail.com</a></span><span class=\" grop-footer-adrs-6ad190e3f2787\">Phone: <a href=\"tel:+16473465688\">+1 647-346-5688</a></span>\n<span class=\" gro