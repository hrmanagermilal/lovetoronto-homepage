POSTGRES_DB=lovetoronto
POSTGRES_USER=lovetoronto
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Leave SMTP_HOST empty until the mail account is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=lovetoronto.office@gmail.com

# Admin site (HTTPS port 81). Only Toronto-area clients (50 km) can reach it.
ADMIN_BASE_URL=https://www.lovetoronto.org:81
# Optional comma-separated emergency allow-list, e.g. 203.0.113.10/32
ADMIN_ALLOWED_CIDRS=
# Allowed distance from Toronto City Hall in km (GTA = 50)
ADMIN_GEO_RADIUS_KM=50
